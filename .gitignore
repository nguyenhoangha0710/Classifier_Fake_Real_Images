# Python cache
__pycache__/
*.py[cod]
*$py.class

# Local Python environments
.venv/
.venv*/
venv/
venv*/

# Python tooling caches and build artifacts
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/
*.egg-info/

# Notebook cache
.ipynb_checkpoints/

# Experiment outputs
outputs/
runs/
wandb/
mlruns/
tensorboard/
modal_results/

# Model-local experiment artifacts (canonical local organization)
baselines/**/artifacts/
benchmarks/**/artifacts/

# Preserve the small, historically tracked Tiny three-model benchmark report.
!benchmarks/commfor_unseen_three_models/artifacts/
benchmarks/commfor_unseen_three_models/artifacts/*
!benchmarks/commfor_unseen_three_models/artifacts/tiny_genimage_three_models_results/
!benchmarks/commfor_unseen_three_models/artifacts/tiny_genimage_three_models_results/**

# Keep the small Full AIDE checkpoint metadata tracked; weight files remain ignored.
!baselines/aide_original_full/artifacts/
baselines/aide_original_full/artifacts/*
!baselines/aide_original_full/artifacts/checkpoints/
baselines/aide_original_full/artifacts/checkpoints/*
!baselines/aide_original_full/artifacts/checkpoints/*.json

# Runtime logs and partial downloads
*.log
*.tmp
*.temp
*.part

# Model checkpoints and weights
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.rar

# Local datasets and caches
dataset/*
!dataset/README.md
!dataset/.gitkeep
.cache/
cache/
hf_cache/
huggingface/

# Kaggle / Colab temporary files
kaggle.json
/working/

# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
