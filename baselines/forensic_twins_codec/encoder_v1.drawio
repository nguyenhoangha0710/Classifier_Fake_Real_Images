<mxCell id="edge11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=2;" edge="1" source="enc" target="proj" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
