<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" type="device"><diagram id="codec-twins-v1" name="Encoder v1"><mxGraphModel dx="1200" dy="1450" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1450" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="FORENSIC TWINS — NATIVE vs RANDOM CODEC&#xa;Bản nháp v1 • SSL chỉ dùng ảnh real" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#64748b;fontColor=#0f172a;fontSize=22;fontStyle=1;spacing=10;" vertex="1" parent="1"><mxGeometry x="70" y="20" width="1060" height="55" as="geometry"/></mxCell>
<mxCell id="input" value="Ảnh real RGB • giữ kích thước gốc&#xa;Decode → RGB [0,1]" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dbeafe;strokeColor=#64748b;fontColor=#0f172a;fontSize=14;fontStyle=0;spacing=10;" vertex="1" parent="1"><mxGeometry x="410" y="95" width="380" height="65" as="geometry"/></mxCell>
<mxCell id="geo" value="Shared rotation / flip&#xa;Cùng phép biến đổi cho cả hai view" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dbeafe;strokeColor=#64748b;fontColor=#0f172a;fontSize=14;fontStyle=0;spacing=10;" vertex="1" parent="1"><mxGeometry x="410" y="190" width="380" height="65" as="geometry"/></mxCell>
<mxCell id="native" value="VIEW 1 — NATIVE&#xa;Identity: không re-encode / resize" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dcfce7;strokeColor=#64748b;fontColor=#0f172a;fontSize=14;fontStyle=0;spacing=10;" vertex="1" parent="1"><mxGeometry x="100" y="300" width="420" height="75" as="geometry"/></mxCell>
<mxCell id="random" value="VIEW 2 — RANDOM PROCESSING&#xa;Sample policy riêng cho từng ảnh" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffedd5;strokeColor=#64748b;fontColor=#0f172a;fontSize=14;fontStyle=0;spacing=10;" vertex="1" parent="1"><mxGeometry x="680" y="300" width="420" height="75" as="geometry"/></mxCell>
<mxCell id="policy" value="CẤU HÌNH THỬ NGHIỆM&#xa;50% JPEG • Q ~ Uniform integer [60,100]&#xa;35% downscale–upscale (s=0.75–1.0) → JPEG&#xa;15% identity • output giữ W×H&#xa;Random interpolation / JPEG subsampling" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff7ed;strokeColor=#64748b;fontColor=#0f172a;fontSize=14;fontStyle=0;spacing=10;" vertex="1" parent="1"><mxGeometry x="680" y="400" width="420" height="125" as="geometry"/></mxCell>
<mxCell id="gray1" value="Grayscale • float [0,1]" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#0f172a;fontSize=14;fontStyle=0;spacing=10;" vertex="1" parent="1"><mxGeometry x="100" y="565" width="420" height="55" as="geometry"/></mxCell>
<mxCell id="gray2" value="Grayscale • float [0,1]" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#0f172a;fontSize=14;fontStyle=0;spacing=10;" vertex="1" parent="1"><mxGeometry x="680" y="565" width="420" height="55" as="geometry"/></mxCell>
<mxCell id="fre1" value="FRE — FROZEN&#xa;1→8 channels • kernel 15 • padding 7" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e2e8f0;strokeColor=#64748b;fontColor=#0f172a;fontSize=14;fontStyle=0;spacing=10;" vertex="1" parent="1"><mxGeometry x="100" y="650" width="420" height="70" as="geometry"/></mxCell>
<mxCell id="fre2" value="FRE — FROZEN&#xa;Cùng checkpoint / weights với view 1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e2e8f0;strokeColor=#64748b;fontColor=#0f172a;fontSize=14;fontStyle=0;spacing=10;" vertex="1" parent="1"><mxGeometry x="680" y="650" width="420" height="70" as="geometry"/></mxCell>
<mxCell id="crop" value="SHARED DISJOINT CROP SAMPLER&#xa;Sample hai rectangle A và B trên cùng hệ tọa độ: A ∩ B = ∅&#xa;Crop A từ residual view 1; crop B từ residual view 2" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fef3c7;strokeColor=#64748b;fontColor=#0f172a;fontSize=14;fontStyle=0;spacing=10;" vertex="1" parent="1"><mxGeometry x="240" y="760" width="720" height="80" as="geometry"/></mxCell>
<mxCell id="enc" value="SHARED ViT-TINY ENCODER fθ — TRAINABLE&#xa;Hai forward, cùng một bộ trọng số&#xa;8-channel input → linear patch embedding (patch 8)&#xa;[CLS] + 2D RoPE → 6 Transformer blocks → LayerNorm&#xa;z₁, z₂: B×192" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ede9fe;strokeColor=#64748b;fontColor=#0f172a;fontSize=14;fontStyle=1;spacing=10;" vertex="1" parent="1"><mxGeometry x="240" y="885" width="720" height="110" as="geometry"/></mxCell>
<mxCell id="proj" value="SHARED PROJECTOR gφ — TRAINABLE&#xa;192 → 2048 → 8192 • theo implementation hiện tại&#xa;e₁, e₂: B×8192" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ede9fe;strokeColor=#64748b;fontColor=#0f172a;fontSize=14;fontStyle=0;spacing=10;" vertex="1" parent="1"><mxGeometry x="240" y="1040" width="720" height="85" as="geometry"/></mxCell>
<mxCell id="loss" value="BARLOW TWINS LOSS&#xa;Chuẩn hóa feature trên global batch → C = E₁ᵀE₂ / B&#xa;L = Σᵢ(1−Cᵢᵢ)² + λ Σᵢ≠ⱼ Cᵢⱼ² • λ = 5×10⁻⁵" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fee2e2;strokeColor=#64748b;fontColor=#0f172a;fontSize=14;fontStyle=1;spacing=10;" vertex="1" parent="1"><mxGeometry x="240" y="1170" width="720" height="80" as="geometry"/></mxCell>
<mxCell id="note" value="CHECKPOINT &amp; PHẠM VI&#xa;Warm-start encoder + projector nếu có; FRE luôn frozen. Reset optimizer / LR schedule khi fine-tune.&#xa;Sau train: bỏ projector, dùng encoder 192-D; fit lại GMM bằng checkpoint mới.&#xa;Giữ inference native cho so sánh đầu tiên. Codec invariance là giả thuyết cần kiểm chứng.&#xa;Native real JPEG vẫn có lịch sử nén; augmentation không tạo ra real lossless thật." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8fafc;strokeColor=#64748b;fontColor=#0f172a;fontSize=14;fontStyle=0;spacing=10;" vertex="1" parent="1"><mxGeometry x="70" y="1300" width="1060" height="100" as="geometry"/></mxCell><mxCell id="edge0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=2;" edge="1" source="input" target="geo" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="edge1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=2;" edge="1" source="geo" target="native" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="edge2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=2;" edge="1" source="geo" target="random" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="edge3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=2;" edge="1" source="native" target="gray1" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="edge4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=2;" edge="1" source="random" target="policy" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="edge5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=2;" edge="1" source="policy" target="gray2" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="edge6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=2;" edge="1" source="gray1" target="fre1" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="edge7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=2;" edge="1" source="gray2" target="fre2" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
