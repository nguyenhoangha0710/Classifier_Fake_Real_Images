10;Per-crop GSD retained&#10;Projector removed" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ede9fe;strokeColor=#94a3b8;fontColor=#0f172a;fontSize=17;fontFamily=Arial;spacing=10;"><mxGeometry x="385" y="1250" width="300" height="100" as="geometry" /></mxCell><mxCell id="pca" value="PCA 768 &gt; 128&#10;Fit on real-fit only&#10;whiten = False" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#0f172a;fontSize=17;fontFamily=Arial;spacing=10;"><mxGeometry x="735" y="1250" width="250" height="100" as="geometry" /></mxCell><mxCell id="gauss" value="Gaussian: 1 component&#10;Full covariance&#10;Fit on real-fit only" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#0f172a;fontSize=17;fontFamily=Arial;spacing=10;"><mxGeometry x="1035" y="1250" width="270" height="100" as="geometry" /></mxCell><mxCell id="score" value="Score = -log p(z | real)&#10;Threshold: real-calibration p95&#10;Fake if score &gt; threshold" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dcfce7;strokeColor=#94a3b8;fontColor=#0f172a;fontSize=17;fontFamily=Arial;spacing=10;"><mxGeometry x="1355" y="1250" width="330" height="100" as="geometry" /></mxCell><mxCell id="e22" source="inputeval" target="enc_eval" edge="1" parent="1" style="edgeStyle=none;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#64748b;dashed=0;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="e23" source="enc_eval" target="pca" edge="1" parent="1" style="edgeStyle=none;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#64748b;dashed=0;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="e24" source="pca" target="gauss" edge="1" parent="1" style="edgeStyle=none;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#64748b;dashed=0;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="e25" source="gauss" target="score" edge="1" parent="1" style="edgeStyle=none;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#64748b;dashed=0;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="foot" value="C0 configuration: K = 8, alpha = 0.25. B0 control: alpha = 0 with the same training protocol.&#10;Eligible SSL pool: parent 200K filtered for two native crops. Density-fit / calibration: saved 160K / 40K splits.&#10;Calibration is disjoint from density-fit, but has been seen during SSL." vertex="1" parent="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=17;fontColor=#0f172a;fontFamily=Arial;"><mxGeometry x="45" y="1390" width="1610" height="80" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>