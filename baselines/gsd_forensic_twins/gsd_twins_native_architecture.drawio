Color=#94a3b8;fontColor=#0f172a;fontSize=19;fontFamily=Arial;spacing=10;"><mxGeometry x="805" y="585" width="400" height="100" as="geometry" /></mxCell><mxCell id="basis" value="V_v: B x 768 x 8&#10;Detached / stop-gradient" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e2e8f0;strokeColor=#94a3b8;fontColor=#0f172a;fontSize=19;fontFamily=Arial;spacing=10;"><mxGeometry x="805" y="725" width="400" height="75" as="geometry" /></mxCell><mxCell id="projection" value="p_v = (z_v V_v) V_v^T&#10;p_v: B x 768" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fef3c7;strokeColor=#94a3b8;fontColor=#0f172a;fontSize=19;fontFamily=Arial;spacing=10;"><mxGeometry x="1280" y="725" width="400" height="75" as="geometry" /></mxCell><mxCell id="supp" value="Partial semantic suppression&#10;z_clean_v = z_v - 0.25 p_v" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dcfce7;strokeColor=#94a3b8;fontColor=#0f172a;fontSize=19;fontFamily=Arial;spacing=10;"><mxGeometry x="1280" y="855" width="400" height="85" as="geometry" /></mxCell><mxCell id="out" value="Output z_clean_v: B x 768" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dcfce7;strokeColor=#94a3b8;fontColor=#0f172a;fontSize=19;fontFamily=Arial;spacing=10;"><mxGeometry x="1280" y="985" width="400" height="70" as="geometry" /></mxCell><mxCell id="e11" source="xv" target="es" edge="1" parent="1" style="edgeStyle=none;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#64748b;dashed=0;exitX=0.21794871794871795;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1140" y="295" /><mxPoint x="1005" y="295" /></Array></mxGeometry></mxCell><mxCell id="e12" source="xv" target="ef" edge="1" parent="1" style="edgeStyle=none;rounded=0;html=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#64748b;dashed=0;exitX=0.782051282051282;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry relati