<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" type="device"><diagram id="option-c-fixed" name="Option C - Workflow and GSD"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1500" pageHeight="1300" math="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="PHƯƠNG ÁN C — WORKFLOW CHÍNH &amp; CHI TIẾT SHARED GSD" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#64748b;fontColor=#0f172a;fontSize=21;spacing=8;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1440" height="55" as="geometry"/></mxCell>
<mxCell id="in" value="Real RGB → shared rotation / flip&#xa;SSL chỉ dùng real training images" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dbeafe;strokeColor=#64748b;fontColor=#0f172a;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="140" y="115" width="360" height="65" as="geometry"/></mxCell>
<mxCell id="v1" value="VIEW 1 — NATIVE&#xa;Identity" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dcfce7;strokeColor=#64748b;fontColor=#0f172a;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="30" y="225" width="240" height="65" as="geometry"/></mxCell>
<mxCell id="v2" value="VIEW 2 — RANDOM&#xa;Processing giữ W × H" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffedd5;strokeColor=#64748b;fontColor=#0f172a;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="370" y="225" width="240" height="65" as="geometry"/></mxCell>
<mxCell id="crop" value="SHARED DISJOINT CROP SAMPLER&#xa;A từ view 1, B từ view 2 • A ∩ B = ∅&#xa;Hai crop RGB riêng" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fef3c7;strokeColor=#64748b;fontColor=#0f172a;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="90" y="345" width="460" height="75" as="geometry"/></mxCell>
<mxCell id="pre" value="CLIP PREPROCESSING&#xa;Input resolution + RGB normalization" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#0f172a;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="90" y="465" width="460" height="65" as="geometry"/></mxCell>
<mxCell id="enc" value="SHARED TRAINABLE CLIP Ef&#xa;Hai forward, cùng weights&#xa;CLS: z₁, z₂ ∈ ℝ^(B×d)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ede9fe;strokeColor=#64748b;fontColor=#0f172a;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="90" y="580" width="460" height="80" as="geometry"/></mxCell>
<mxCell id="gsd" value="SHARED GSD&#xa;Input: z₁, z₂ → output: ẑ₁, ẑ₂&#xa;Cùng basis U và suppression strength α" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fef3c7;strokeColor=#64748b;fontColor=#0f172a;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="90" y="720" width="460" height="80" as="geometry"/></mxCell>
<mxCell id="proj" value="SHARED TRAINABLE PROJECTOR&#xa;d → hidden → D&#xa;Output: e₁, e₂ ∈ ℝ^(B×D)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ede9fe;strokeColor=#64748b;fontColor=#0f172a;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="90" y="860" width="460" height="70" as="geometry"/></mxCell>
<mxCell id="loss" value="NORMALIZE → BARLOW TWINS LOSS&#xa;Chuẩn hóa trên global batch&#xa;C = normalized(E₁)ᵀ normalized(E₂) / B&#xa;LBT = Σᵢ(1−Cᵢᵢ)² + λBT Σᵢ≠ⱼCᵢⱼ²" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fee2e2;strokeColor=#64748b;fontColor=#0f172a;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="90" y="990" width="460" height="100" as="geometry"/></mxCell>
<mxCell id="detailtitle" value="BÊN TRONG SHARED GSD — FIXED REFERENCE BASIS" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#64748b;fontColor=#0f172a;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="730" y="110" width="700" height="55" as="geometry"/></mxCell>
<mxCell id="ref" value="1. OFFLINE: REAL REFERENCE SET&#xa;Chỉ thuộc training split • Nref ảnh" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e0f2fe;strokeColor=#64748b;fontColor=#0f172a;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="860" y="205" width="440" height="70" as="geometry"/></mxCell>
<mxCell id="anchor" value="FROZEN CLIP Es • eval / no_grad&#xa;Cùng pretrained initialization với Ef&#xa;CLS trước CLIP projection head: S ∈ ℝ^(Nref×d)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e2e8f0;strokeColor=#64748b;fontColor=#0f172a;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="860" y="315" width="440" height="85" as="geometry"/></mxCell>
<mxCell id="svd" value="SVD KHÔNG CENTERING&#xa;S = AΣVᵀ → U = V[:, :K]&#xa;U ∈ ℝ^(d×K) • UᵀU = I" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fef3c7;strokeColor=#64748b;fontColor=#0f172a;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="860" y="445" width="440" height="80" as="geometry"/></mxCell>
<mxCell id="save" value="LƯU BASIS U • STOP-GRADIENT&#xa;Tính một lần, cố định khi train / inference&#xa;Es không cần chạy online" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fef3c7;strokeColor=#64748b;fontColor=#0f172a;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="860" y="570" width="440" height="75" as="geometry"/></mxCell>
<mxCell id="zin" value="2. ONLINE INPUT&#xa;zᵥ ∈ ℝ^(B×d) • v=1,2" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ede9fe;strokeColor=#64748b;fontColor=#0f172a;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="720" y="710" width="240" height="65" as="geometry"/></mxCell>
<mxCell id="comp" value="CHIẾU LÊN SEMANTIC SUBSPACE&#xa;pᵥ = (zᵥU)Uᵀ&#xa;Dùng chung U cho cả hai view" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fef3c7;strokeColor=#64748b;fontColor=#0f172a;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="1050" y="705" width="380" height="80" as="geometry"/></mxCell>
<mxCell id="sub" value="SUPPRESS THÀNH PHẦN ĐƯỢC CHIẾU&#xa;ẑᵥ = zᵥ − αpᵥ&#xa;α cố định theo từng run" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fef3c7;strokeColor=#64748b;fontColor=#0f172a;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="1050" y="840" width="380" height="75" as="geometry"/></mxCell>
<mxCell id="out" value="OUTPUT: ẑ₁, ẑ₂ ∈ ℝ^(B×d)&#xa;Gradient truyền về Ef qua zᵥ&#xa;U không được cập nhật" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dcfce7;strokeColor=#64748b;fontColor=#0f172a;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="1050" y="965" width="380" height="70" as="geometry"/></mxCell>
<mxCell id="note" value="QUY ƯỚC THIẾT KẾ&#xa;Shared GSD = cùng phép toán, U và α; không trộn hai view.&#xa;Đây là biến thể lấy cảm hứng từ GSD, suppression cuối encoder.&#xa;Fit GMM / inference: Ef → cùng Shared GSD → GMM; bỏ projector.&#xa;Control B: α=0. K, α, backbone, crop size và projector cần chốt." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8fafc;strokeColor=#64748b;fontColor=#0f172a;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="720" y="1095" width="710" height="120" as="geometry"/></mxCell>
<mxCell id="policy" value="RANDOM PROCESSING — CẤU HÌNH KHỞI ĐẦU&#xa;50% JPEG Q∈[80,100]; 35% down/up s∈[0.75,1] → JPEG&#xa;15% identity; random interpolation / JPEG subsampling&#xa;Mọi nhánh giữ kích thước gốc trước crop." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff7ed;strokeColor=#64748b;fontColor=#0f172a;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="30" y="1150" width="580" height="100" as="geometry"/></mxCell><mxCell id="e0" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#475569;strokeWidth=2;" edge="1" source="in" target="v1" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#475569;strokeWidth=2;" edge="1" source="in" target="v2" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#475569;strokeWidth=2;" edge="1" source="v1" target="crop" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#475569;strokeWidth=2;" edge="1" source="v2" target="crop" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#475569;strokeWidth=2;" edge="1" source="crop" target="pre" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#475569;strokeWidth=2;" edge="1" source="pre" target="enc" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#475569;strokeWidth=2;" edge="1" source="enc" target="gsd" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#475569;strokeWidth=2;" edge="1" source="gsd" target="proj" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#475569;strokeWidth=2;" edge="1" source="proj" target="loss" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#475569;strokeWidth=2;" edge="1" source="ref" target="anchor" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#475569;strokeWidth=2;" edge="1" source="anchor" target="svd" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#475569;strokeWidth=2;" edge="1" source="svd" target="save" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#475569;strokeWidth=2;" edge="1" source="save" target="comp" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#475569;strokeWidth=2;" edge="1" source="zin" target="comp" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e14" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#475569;strokeWidth=2;" edge="1" source="comp" target="sub" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e15" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#475569;strokeWidth=2;" edge="1" source="zin" target="sub" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
