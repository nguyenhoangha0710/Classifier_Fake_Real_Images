<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" type="device"><diagram id="option-c-dynamic" name="Option C - Per-view GSD"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1620" pageHeight="1340" math="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="PHƯƠNG ÁN C — GSD VỚI BASIS RIÊNG CHO TỪNG VIEW&#xa;Bản đề xuất: per-crop patch-token SVD, suppression cuối encoder" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#64748b;fontColor=#0f172a;fontSize=20;spacing=8;" vertex="1" parent="1"><mxGeometry x="30" y="15" width="1560" height="60" as="geometry"/></mxCell>
<mxCell id="in" value="Real RGB → shared rotation / flip&#xa;SSL pretraining chỉ dùng real" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dbeafe;strokeColor=#64748b;fontColor=#0f172a;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="155" y="115" width="390" height="65" as="geometry"/></mxCell>
<mxCell id="v1" value="VIEW 1 — NATIVE&#xa;Identity" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dcfce7;strokeColor=#64748b;fontColor=#0f172a;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="30" y="225" width="260" height="65" as="geometry"/></mxCell>
<mxCell id="v2" value="VIEW 2 — RANDOM PROCESSING&#xa;Output giữ W × H" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffedd5;strokeColor=#64748b;fontColor=#0f172a;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="400" y="225" width="260" height="65" as="geometry"/></mxCell>
<mxCell id="crop" value="SHARED DISJOINT CROP SAMPLER&#xa;Crop A từ view 1, crop B từ view 2 • A ∩ B = ∅&#xa;RGB → CLIP preprocessing cho từng crop" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fef3c7;strokeColor=#64748b;fontColor=#0f172a;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="110" y="345" width="470" height="80" as="geometry"/></mxCell>
<mxCell id="shared" value="SHARED GSD ENCODER&#xa;Mỗi crop qua frozen CLIP Es + trainable CLIP Ef&#xa;Shared Es weights • shared Ef weights&#xa;Basis V₁,K và V₂,K được tính riêng&#xa;Output: ẑ₁, ẑ₂ ∈ ℝ^(B×d)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ede9fe;strokeColor=#64748b;fontColor=#0f172a;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="110" y="495" width="470" height="100" as="geometry"/></mxCell>
<mxCell id="proj" value="SHARED TRAINABLE PROJECTOR&#xa;d → hidden → D&#xa;Output: e₁, e₂ ∈ ℝ^(B×D)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ede9fe;strokeColor=#64748b;fontColor=#0f172a;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="110" y="685" width="470" height="80" as="geometry"/></mxCell>
<mxCell id="loss" value="NORMALIZE → BARLOW TWINS LOSS&#xa;Chuẩn hóa trên global batch&#xa;C = normalized(E₁)ᵀ normalized(E₂) / B&#xa;LBT = Σᵢ(1−Cᵢᵢ)² + λBT Σᵢ≠ⱼ Cᵢⱼ²" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fee2e2;strokeColor=#64748b;fontColor=#0f172a;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="110" y="855" width="470" height="105" as="geometry"/></mxCell>
<mxCell id="policy" value="RANDOM PROCESSING — CẤU HÌNH KHỞI ĐẦU&#xa;50% JPEG Q∈[80,100]; 35% down/up s∈[0.75,1] → JPEG&#xa;15% identity; random interpolation / JPEG subsampling&#xa;Tất cả processing trước crop; cùng input normalization cho Es và Ef." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff7ed;strokeColor=#64748b;fontColor=#0f172a;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="30" y="1030" width="630" height="105" as="geometry"/></mxCell>
<mxCell id="detail" value="CHI TIẾT SHARED GSD ENCODER&#xa;Lặp riêng cho v=1 và v=2, từng ảnh trong batch" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#64748b;fontColor=#0f172a;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="760" y="110" width="800" height="60" as="geometry"/></mxCell>
<mxCell id="xin" value="CROP RGB xᵥ&#xa;Sau cùng CLIP preprocessing" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dbeafe;strokeColor=#64748b;fontColor=#0f172a;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="980" y="210" width="360" height="65" as="geometry"/></mxCell>
<mxCell id="es" value="FROZEN CLIP Es&#xa;Cùng initialization pretrained với Ef&#xa;Frozen / eval / no_grad" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e2e8f0;strokeColor=#64748b;fontColor=#0f172a;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="750" y="330" width="370" height="85" as="geometry"/></mxCell>
<mxCell id="ef" value="TRAINABLE CLIP Ef&#xa;Gradient cập nhật weights&#xa;Hai view dùng cùng Ef" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ede9fe;strokeColor=#64748b;fontColor=#0f172a;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="1200" y="330" width="370" height="85" as="geometry"/></mxCell>
<mxCell id="sem" value="SEMANTIC PATCH TOKENS Sᵥ&#xa;Shape: Npatch × d, bỏ CLS&#xa;Tính riêng cho mỗi crop / mỗi ảnh" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e0f2fe;strokeColor=#64748b;fontColor=#0f172a;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="750" y="465" width="370" height="80" as="geometry"/></mxCell>
<mxCell id="z" value="UPDATE FEATURE zᵥ&#xa;CLS: 1 × d, trước projection head&#xa;Cùng chiều hidden d với semantic tokens" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ede9fe;strokeColor=#64748b;fontColor=#0f172a;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="1200" y="465" width="370" height="80" as="geometry"/></mxCell>
<mxCell id="svd" value="PER-CROP SVD (không centering)&#xa;Sᵥ = AᵥΣᵥVᵥᵀ&#xa;Vᵥ,K: d × K • top-K right singular vectors&#xa;K ≤ min(Npatch, d)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fef3c7;strokeColor=#64748b;fontColor=#0f172a;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="750" y="600" width="370" height="95" as="geometry"/></mxCell>
<mxCell id="projection" value="SEMANTIC PROJECTION&#xa;pᵥ = (zᵥ Vᵥ,K) Vᵥ,Kᵀ&#xa;z₁ chỉ dùng V₁,K; z₂ chỉ dùng V₂,K" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fef3c7;strokeColor=#64748b;fontColor=#0f172a;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="980" y="755" width="440" height="85" as="geometry"/></mxCell>
<mxCell id="subtract" value="SUPPRESSION → GIỮ FEATURE CÒN LẠI&#xa;ẑᵥ = zᵥ − α pᵥ&#xa;α=1: phần trực giao; 0&lt;α&lt;1: suppress một phần&#xa;Vᵥ,K stop-gradient • backprop qua zᵥ → Ef" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dcfce7;strokeColor=#64748b;fontColor=#0f172a;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="980" y="900" width="440" height="90" as="geometry"/></mxCell>
<mxCell id="deploy" value="FIT GMM &amp; INFERENCE&#xa;Mỗi test crop cũng chạy Es → SVD và Ef → suppression; bỏ projector.&#xa;Fit lại GMM bằng cùng representation ẑ. Không cần ghép test batch để tạo basis.&#xa;Chi phí online: cả Es, Ef và SVD cho từng crop." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e0f2fe;strokeColor=#64748b;fontColor=#0f172a;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="750" y="1040" width="820" height="100" as="geometry"/></mxCell>
<mxCell id="foot" value="QUY ƯỚC &amp; GIỚI HẠN&#xa;Shared = cùng Es weights, cùng Ef weights, cùng thuật toán GSD / K / α; không dùng chung basis giữa hai view.&#xa;Chọn cùng backbone và cùng hidden layer cho Es / Ef. SVD dùng patch tokens; update feature dùng CLS trong cùng không gian hidden.&#xa;Đây là thiết kế đề xuất cần ablation, không phải tái lập đầy đủ GSD paper. Control: α=0; chốt backbone, K, α, crop size, D và λBT." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8fafc;strokeColor=#64748b;fontColor=#0f172a;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="30" y="1195" width="1540" height="100" as="geometry"/></mxCell><mxCell id="e0" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#475569;strokeWidth=2;" edge="1" source="in" target="v1" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#475569;strokeWidth=2;" edge="1" source="in" target="v2" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#475569;strokeWidth=2;" edge="1" source="v1" target="crop" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#475569;strokeWidth=2;" edge="1" source="v2" target="crop" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#475569;strokeWidth=2;" edge="1" source="crop" target="shared" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#475569;strokeWidth=2;" edge="1" source="shared" target="proj" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#475569;strokeWidth=2;" edge="1" source="proj" target="loss" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#475569;strokeWidth=2;" edge="1" source="xin" target="es" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#475569;strokeWidth=2;" edge="1" source="xin" target="ef" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#475569;strokeWidth=2;" edge="1" source="es" target="sem" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#475569;strokeWidth=2;" edge="1" source="ef" target="z" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#475569;strokeWidth=2;" edge="1" source="sem" target="svd" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#475569;strokeWidth=2;" edge="1" source="svd" target="projection" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#475569;strokeWidth=2;" edge="1" source="z" target="projection" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e14" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#475569;strokeWidth=2;" edge="1" source="projection" target="subtract" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="detail-link" value="chi tiết" style="edgeStyle=orthogonalEdgeStyle;dashed=1;endArrow=open;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#64748b;" edge="1" source="shared" target="detail" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
