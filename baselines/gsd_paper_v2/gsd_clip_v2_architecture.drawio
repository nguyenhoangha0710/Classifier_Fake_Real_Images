  <diagram id="gsd-math" name="02 - GSD Batch-SVD">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="m0"/>
        <mxCell id="m1" parent="m0"/>
        <mxCell id="mtitle" value="GSD TẠI MỘT LAYER l — BATCH-SVD (TRAINING MẶC ĐỊNH)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#0f172a;strokeColor=#0f172a;fontColor=#ffffff;fontSize=22;fontStyle=1;spacing=10;" vertex="1" parent="m1"><mxGeometry x="30" y="20" width="1540" height="65" as="geometry"/></mxCell>
        <mxCell id="anchorTokens" value="FROZEN ANCHOR TOKENS&#xa;gᵢ,ₗ ∈ R^((N+1)×d)&#xa;Bỏ CLS → P̄ᵢ,ₗ ∈ R^(N×d)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e0f2fe;strokeColor=#0284c7;fontColor=#0c4a6e;fontSize=15;fontStyle=1;spacing=8;" vertex="1" parent="m1"><mxGeometry x="80" y="140" width="340" height="100" as="geometry"/></mxCell>
        <mxCell id="concat" value="CONCAT THEO TOKEN DIMENSION&#xa;M̄ₗ = [P̄₁,ₗ; … ; P̄ᴮ,ₗ]&#xa;M̄ₗ ∈ R^((B·N)×d)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e3a8a;fontSize=15;fontStyle=1;spacing=8;" vertex="1" parent="m1"><mxGeometry x="480" y="140" width="380" height="100" as="geometry"/></mxCell>
        <mxCell id="svd" value="MỘT SVD CHO MỖI LAYER / MINI-BATCH&#xa;M̄ₗ = Uₗ⁽ᵇ⁾ Σₗ⁽ᵇ⁾ (Vₗ⁽ᵇ⁾)ᵀ" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#78350f;fontSize=15;fontStyle=1;spacing=8;" vertex="1" parent="m1"><mxGeometry x="920" y="140" width="360" height="100" as="geometry"/></mxCell>
        <mxCell id="basis" value="SEMANTIC BASIS CHUNG&#xa;Vₗ⁽ᵇ,ᵏ⁾ = top-k right singular vectors&#xa;Shape d×k • k=64" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fef9c3;strokeColor=#ca8a04;fontColor=#713f12;fontSize=15;fontStyle=1;spacing=8;" vertex="1" parent="m1"><mxGeometry x="1160" y="300" width="360" height="105" as="geometry"/></mxCell>

        <mxCell id="trainTokens" value="TRAINABLE FORENSIC TOKENS&#xa;fᵢ,ₗ ∈ R^((N+1)×d)&#xa;Có CLS + patch tokens" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ede9fe;strokeColor=#7c3aed;fontColor=#4c1d95;fontSize=15;fontStyle=1;spacing=8;" vertex="1" parent="m1"><mxGeometry x="80" y="390" width="340" height="100" as="geometry"/></mxCell>
        <mxCell id="projection" value="SEMANTIC PROJECTION&#xa;fᵢ,ₗ,∥ = fᵢ,ₗ Vₗ⁽ᵇ,ᵏ⁾ (Vₗ⁽ᵇ,ᵏ⁾)ᵀ&#xa;Shape giữ nguyên (N+1)×d" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fae8ff;strokeColor=#a21caf;fontColor=#701a75;fontSize=15;fontStyle=1;spacing=8;" vertex="1" parent="m1"><mxGeometry x="500" y="390" width="440" height="105" as="geometry"/></mxCell>
        <mxCell id="occupancy" value="SEMANTIC OCCUPANCY&#xa;rᵢ,ₗ = ||fᵢ,ₗ,∥||²F / ||fᵢ,ₗ||²F&#xa;Một scalar riêng cho từng sample/layer" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffedd5;strokeColor=#ea580c;fontColor=#7c2d12;fontSize=15;fontStyle=1;spacing=8;" vertex="1" parent="m1"><mxGeometry x="160" y="590" width="430" height="105" as="geometry"/></mxCell>
        <mxCell id="lambda" value="ADAPTIVE SUPPRESSION&#xa;λᵢ,ₗ = λmax · sigmoid(aₗ rᵢ,ₗ + bₗ)&#xa;λmax=1 • init aₗ=2, bₗ=1&#xa;aₗ,bₗ learnable theo layer" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fee2e2;strokeColor=#dc2626;fontColor=#7f1d1d;fontSize=15;fontStyle=1;spacing=8;" vertex="1" parent="m1"><mxGeometry x="670" y="580" width="430" height="125" as="geometry"/></mxCell>
        <mxCell id="subtract" value="GEOMETRIC SEMANTIC DECOUPLING&#xa;f̂ᵢ,ₗ = fᵢ,ₗ − λᵢ,ₗ fᵢ,ₗ,∥&#xa;Semantic mạnh → suppress mạnh hơn" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=16;fontStyle=1;spacing=8;" vertex="1" parent="m1"><mxGeometry x="450" y="790" width="620" height="120" as="geometry"/></mxCell>
        <mxCell id="next" value="Đưa f̂ᵢ,ₗ sang layer kế tiếp&#xa;Lặp tại 4 layer cuối" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d1fae5;strokeColor=#059669;fontColor=#064e3b;fontSize=15;fontStyle=1;spacing=8;" vertex="1" parent="m1"><mxGeometry x="560" y="970" width="400" height="75" as="geometry"/></mxCell>
        <mxCell id="mnote" value="Điểm dễ cài sai&#xa;1. SVD dùng non-CLS tokens của frozen anchor.&#xa;2. Projection áp lên toàn bộ trainable token matrix.&#xa;3. Batch dùng chung V, nhưng r và λ vẫn theo từng sample.&#xa;4. Tính lại basis ở từng GSD layer và từng iteration.&#xa;5. Không center token matrix trong công thức paper v2." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8fafc;strokeColor=#64748b;fontColor=#334155;fontSize=14;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="m1"><mxGeometry x="1130" y="560" width="400" height="250" as="geometry"/></mxCell>
        <mxCell id="me1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#0284c7;strokeWidth=2;" edge="1" parent="m1" source="anchorTokens" target="concat"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="me2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#2563eb;strokeWidth=2;" edge="1" parent="m1" source="concat" target="svd"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="me3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#d97706;strokeWidth=2;" edge="1" parent="m1" source="svd" target="basis"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="me4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#7c3aed;strokeWidth=2;" edge="1" parent="m1" source="trainTokens" target="projection"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="me5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;dashed=1;dashPattern=8 4;strokeColor=#ca8a04;strokeWidth=2;" edge="1" parent="m1" source="basis" target="projection"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="me6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#a21caf;strokeWidth=2;" edge="1" parent="m1" source="projection" target="occupancy"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="me7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#ea580c;strokeWidth=2;" edge="1" parent="m1" source="occupancy" target="lambda"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="me8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#dc2626;strokeWidth=2;" edge="1" parent="m1" source="lambda" target="subtract"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="me9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#a21caf;strokeWidth=2;" edge="1" parent="m1" source="projection" target="subtract"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="me10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#7c3aed;strokeWidth=2;" edge="1" parent="m1" source="trainTokens" target="subtract"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="me11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#16a34a;strokeWidth=2;" edge="1" parent="m1" source="subtract" target="next"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="gsd-training" name="03 - Train &amp; Inference">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="t0"/>
        <mxCell id="t1" parent="t0"/>
        <mxCell id="ttitle" value="GSD-CLIP v2 — TRAINING RECIPE &amp; INFERENCE PROTOCOLS" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#0f172a;strokeColor=#0f172a;fontColor=#ffffff;fontSize=22;fontStyle=1;spacing=10;" vertex="1" parent="t1"><mxGeometry x="30" y="20" width="1540" height="65" as="geometry"/></mxCell>
        <mxCell id="published" value="THÔNG SỐ PAPER CÔNG BỐ&#xa;Backbone: pretrained CLIP ViT-L/14&#xa;Optimizer: AdamW&#xa;Backbone LR: 1×10⁻⁶&#xa;Train batch: 128&#xa;Test batch: 512&#xa;Hardware: NVIDIA A100&#xa;Augment: Gaussian blur + JPEG&#xa;GSD: last 4 layers, Batch-SVD&#xa;k=64; λmax=1; init a=2, b=1&#xa;Loss: 2-class cross-entropy" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="t1"><mxGeometry x="50" y="125" width="460" height="310" as="geometry"/></mxCell>
        <mxCell id="loop" value="MỘT TRAINING STEP&#xa;1. Load B=128 + binary labels&#xa;2. Augment/preprocess&#xa;3. Forward frozen anchor + trainable CLIP&#xa;4. Blocks 1–20 bình thường&#xa;5. Mỗi block 21–24: Batch-SVD → r → λ → subtract&#xa;6. Average pooling → linear classifier&#xa;7. Cross-entropy Eq. (11)&#xa;8. Backprop forensic CLIP + head + {aₗ,bₗ}&#xa;9. AdamW update; anchor giữ frozen" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ede9fe;strokeColor=#7c3aed;fontColor=#4c1d95;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="t1"><mxGeometry x="570" y="125" width="500" height="310" as="geometry"/></mxCell>
        <mxCell id="missing" value="KHÔNG ĐƯỢC PAPER CÔNG BỐ&#xa;• epoch/iterations, LR schedule, warmup&#xa;• AdamW betas/eps/weight decay&#xa;• classifier LR&#xa;• input resolution/checkpoint/provider CLIP&#xa;• resize/crop/flip/normalization chi tiết&#xa;• blur/JPEG probability và severity range&#xa;• frame sampler, class sampler/balance&#xa;• số A100, DDP, precision, grad clipping&#xa;• seed, checkpoint selection&#xa;• SVD solver/precision/rank fallback&#xa;&#xa;⇒ Chưa thể reproduction bit-exact nếu chưa có official code/config." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fee2e2;strokeColor=#dc2626;fontColor=#7f1d1d;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="t1"><mxGeometry x="1130" y="125" width="420" height="310" as="geometry"/></mxCell>

        <mxCell id="datasets" value="TRAIN / TEST PROTOCOLS (CÁC RUN RIÊNG)&#xa;Face: FF++ c23 → CD1/CD2, DFD, DFDC, DFDCP&#xa;Face: FF++ c23 → DF40 unseen manipulations&#xa;Synthetic: ProGAN + real → UniversalFakeDetect 19 sets&#xa;GenImage: SD v1.4 → MJ, SD1.5, ADM, GLIDE, Wukong, VQDM, BigGAN" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff7ed;strokeColor=#ea580c;fontColor=#7c2d12;fontSize=15;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="t1"><mxGeometry x="50" y="490" width="1500" height="150" as="geometry"/></mxCell>

        <mxCell id="inferTitle" value="BA CHẾ ĐỘ INFERENCE" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#334155;strokeColor=#334155;fontColor=#ffffff;fontSize=18;fontStyle=1;spacing=8;" vertex="1" parent="t1"><mxGeometry x="50" y="690" width="1500" height="55" as="geometry"/></mxCell>
        <mxCell id="batchInfer" value="BATCH-INFERENCE — MẶC ĐỊNH&#xa;Batch-SVD trên test mini-batch tại từng GSD layer&#xa;Shared V cho batch; r và λ riêng từng sample&#xa;Nhanh, phù hợp benchmark dataset-level" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e3a8a;fontSize=15;spacing=10;" vertex="1" parent="t1"><mxGeometry x="50" y="790" width="460" height="150" as="geometry"/></mxCell>
        <mxCell id="perInfer" value="PER-SAMPLE INFERENCE&#xa;Single-SVD trên patch tokens từng ảnh/layer&#xa;Không cần batch statistics&#xa;Phù hợp streaming nhưng chi phí cao" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#78350f;fontSize=15;spacing=10;" vertex="1" parent="t1"><mxGeometry x="570" y="790" width="460" height="150" as="geometry"/></mxCell>
        <mxCell id="refInfer" value="REFERENCE-BASED INFERENCE&#xa;SVD một reference set rồi tái dùng basis&#xa;Paper ablation face: 512 ảnh từ FF++ hoặc CDv2&#xa;Hiệu quả khi không muốn SVD mỗi ảnh" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e0f2fe;strokeColor=#0284c7;fontColor=#0c4a6e;fontSize=15;spacing=10;" vertex="1" parent="t1"><mxGeometry x="1090" y="790" width="460" height="150" as="geometry"/></mxCell>
        <mxCell id="warning" value="LƯU Ý PHIÊN BẢN&#xa;Sơ đồ này bám arXiv v2 (03/06/2026). Không dùng thiết kế per-crop K=8, alpha=0.25, Barlow Twins hoặc GMM trong thư mục gsd_forensic_twins vì đó là extension riêng của dự án, không phải GSD-CLIP v2." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8fafc;strokeColor=#64748b;fontColor=#334155;fontSize=14;spacing=12;" vertex="1" parent="t1"><mxGeometry x="250" y="1000" width="1100" height="120" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
