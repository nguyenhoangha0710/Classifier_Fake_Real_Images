  <diagram id="gsd-architecture" name="01 - Architecture">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="GSD-CLIP v2 — KIẾN TRÚC PAPER-FAITHFUL&#xa;Dual-stream CLIP ViT-L/14 • Batch-SVD • adaptive semantic suppression • supervised real/fake" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#0f172a;strokeColor=#0f172a;fontColor=#ffffff;fontSize=22;fontStyle=1;spacing=10;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1540" height="70" as="geometry"/></mxCell>
        <mxCell id="input" value="MINI-BATCH ẢNH x, NHÃN y&#xa;Cùng input đưa qua hai nhánh&#xa;Train B=128" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#0f172a;fontSize=15;fontStyle=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="610" y="120" width="380" height="80" as="geometry"/></mxCell>

        <mxCell id="trainHead" value="TRAINABLE FORENSIC BRANCH&#xa;Fine-tune end-to-end" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ede9fe;strokeColor=#7c3aed;fontColor=#4c1d95;fontSize=17;fontStyle=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="70" y="245" width="650" height="60" as="geometry"/></mxCell>
        <mxCell id="anchorHead" value="FROZEN SEMANTIC ANCHOR&#xa;Cùng pretrained CLIP • frozen / không update" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e2e8f0;strokeColor=#475569;fontColor=#0f172a;fontSize=17;fontStyle=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="880" y="245" width="650" height="60" as="geometry"/></mxCell>

        <mxCell id="trainPatch" value="CLIP ViT-L/14&#xa;Patch embedding + positional embedding&#xa;Tokens: (N+1) × d" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f5f3ff;strokeColor=#8b5cf6;fontColor=#2e1065;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="100" y="345" width="290" height="90" as="geometry"/></mxCell>
        <mxCell id="train20" value="Transformer blocks 1–20&#xa;Không GSD&#xa;Giữ low-level forensic cues" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f5f3ff;strokeColor=#8b5cf6;fontColor=#2e1065;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="430" y="345" width="260" height="90" as="geometry"/></mxCell>
        <mxCell id="anchorPatch" value="CLIP ViT-L/14&#xa;Patch embedding + positional embedding&#xa;Cùng initialization" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8fafc;strokeColor=#64748b;fontColor=#0f172a;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="910" y="345" width="290" height="90" as="geometry"/></mxCell>
        <mxCell id="anchor20" value="Transformer blocks 1–20&#xa;Frozen semantic geometry&#xa;Không gradient update" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8fafc;strokeColor=#64748b;fontColor=#0f172a;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="1240" y="345" width="260" height="90" as="geometry"/></mxCell>

        <mxCell id="g21" value="GSD Transformer block 21&#xa;F̂ = F − λ F∥" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#78350f;fontSize=14;fontStyle=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="110" y="500" width="260" height="70" as="geometry"/></mxCell>
        <mxCell id="g22" value="GSD Transformer block 22&#xa;Basis và λ tính lại" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#78350f;fontSize=14;fontStyle=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="410" y="500" width="260" height="70" as="geometry"/></mxCell>
        <mxCell id="g23" value="GSD Transformer block 23&#xa;Basis và λ tính lại" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#78350f;fontSize=14;fontStyle=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="110" y="620" width="260" height="70" as="geometry"/></mxCell>
        <mxCell id="g24" value="GSD Transformer block 24&#xa;Basis và λ tính lại" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#78350f;fontSize=14;fontStyle=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="410" y="620" width="260" height="70" as="geometry"/></mxCell>

        <mxCell id="a21" value="Anchor block 21&#xa;non-CLS tokens → Batch-SVD" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e0f2fe;strokeColor=#0284c7;fontColor=#0c4a6e;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="930" y="500" width="260" height="70" as="geometry"/></mxCell>
        <mxCell id="a22" value="Anchor block 22&#xa;non-CLS tokens → Batch-SVD" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e0f2fe;strokeColor=#0284c7;fontColor=#0c4a6e;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="1230" y="500" width="260" height="70" as="geometry"/></mxCell>
        <mxCell id="a23" value="Anchor block 23&#xa;non-CLS tokens → Batch-SVD" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e0f2fe;strokeColor=#0284c7;fontColor=#0c4a6e;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="930" y="620" width="260" height="70" as="geometry"/></mxCell>
        <mxCell id="a24" value="Anchor block 24&#xa;non-CLS tokens → Batch-SVD" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e0f2fe;strokeColor=#0284c7;fontColor=#0c4a6e;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="1230" y="620" width="260" height="70" as="geometry"/></mxCell>

        <mxCell id="pool" value="AVERAGE POOLING&#xa;Semantically decoupled feature" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=14;fontStyle=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="190" y="760" width="400" height="70" as="geometry"/></mxCell>
        <mxCell id="classifier" value="LINEAR 2-CLASS CLASSIFIER&#xa;logits: Real / Fake" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fee2e2;strokeColor=#dc2626;fontColor=#7f1d1d;fontSize=14;fontStyle=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="190" y="870" width="400" height="70" as="geometry"/></mxCell>
        <mxCell id="loss" value="SOFTMAX CROSS-ENTROPY — Eq. (11)&#xa;Backprop: forensic CLIP + classifier + {aₗ,bₗ}" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffe4e6;strokeColor=#e11d48;fontColor=#881337;fontSize=14;fontStyle=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="190" y="980" width="400" height="75" as="geometry"/></mxCell>

        <mxCell id="defaults" value="PAPER DEFAULTS (v2)&#xa;• Pretrained CLIP ViT-L/14&#xa;• 24 blocks; GSD ở 4 block cuối&#xa;• Batch-SVD, k=64&#xa;• λmax=1&#xa;• aₗ=2, bₗ=1 lúc khởi tạo&#xa;• AdamW, backbone LR=1e−6&#xa;• Train B=128; test B=512&#xa;• NVIDIA A100" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff7ed;strokeColor=#ea580c;fontColor=#7c2d12;fontSize=14;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="850" y="760" width="680" height="295" as="geometry"/></mxCell>
        <mxCell id="note" value="Luồng màu xanh đứt nét = semantic basis từ frozen anchor sang GSD cùng layer.&#xa;Frozen branch không nhận gradient; GSD không có auxiliary loss." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8fafc;strokeColor=#64748b;fontColor=#334155;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="650" y="930" width="170" height="125" as="geometry"/></mxCell>

