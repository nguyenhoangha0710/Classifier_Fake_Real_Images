<mxfile host="app.diagrams.net"><diagram id="Kiến trúc CAPD" name="Kiến trúc CAPD"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="1560" pageHeight="900"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="CAPD — Codec-Aligned Patch Detector: kiến trúc" style="text;html=1;fontSize=22;fontStyle=1;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1000" height="34" as="geometry"/></mxCell><mxCell id="c2" value="Backbone: DINOv3 ViT-L/16" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E3ECFA;strokeColor=#3A6BC4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fontSize=14;fontColor=#3A6BC4;fontFamily=Inter;opacity=60;" vertex="1" parent="1"><mxGeometry x="466" y="92" width="278" height="300" as="geometry"/></mxCell><mxCell id="c3" value="PatchHead (train)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FDEBD8;strokeColor=#D9822B;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fontSize=14;fontColor=#D9822B;fontFamily=Inter;opacity=60;" vertex="1" parent="1"><mxGeometry x="782" y="92" width="262" height="300" as="geometry"/></mxCell><mxCell id="c4" value="Hàm loss (chỉ khi train)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FBE3E6;strokeColor=#C2414F;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fontSize=14;fontColor=#C2414F;fontFamily=Inter;opacity=60;" vertex="1" parent="1"><mxGeometry x="1080" y="412" width="450" height="158" as="geometry"/></mxCell><mxCell id="c5" value="Mở rộng B — Gated-Experts (chỉ làm khi CAPD đã ổn định; oracle gain &gt; 3 điểm)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F7F7F5;strokeColor=#8A8A85;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fontSize=14;fontColor=#8A8A85;fontFamily=Inter;opacity=60;dashed=1;" vertex="1" parent="1"><mxGeometry x="24" y="620" width="1506" height="255" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Ảnh RGB&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;độ phân giải gốc&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;(không resize)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2F7;strokeColor=#5B6B82;fontFamily=Inter;fontSize=13;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="24" y="205" width="170" height="68" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Train&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;random crop 224×224&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;codec aug ghép cặp real–fake&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F3F7;strokeColor=#2C8AA6;fontFamily=Inter;fontSize=13;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="236" y="140" width="196" height="68" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Test&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;tiling 224×224 toàn ảnh&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;(tối đa 16 tile)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F3F7;strokeColor=#2C8AA6;fontFamily=Inter;fontSize=13;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="236" y="268" width="196" height="68" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Patch embedding 16×16&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;224² → 196 token + CLS&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3ECFA;strokeColor=#3A6BC4;fontFamily=Inter;fontSize=13;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="486" y="132" width="238" height="51" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;24 block Transformer&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;trọng số gốc đóng băng&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3ECFA;strokeColor=#3A6BC4;fontFamily=Inter;fontSize=13;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="486" y="212" width="238" height="51" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;LoRA r = 8 (train)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;chèn vào qkv, proj, fc1, fc2 (~6M)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEBD8;strokeColor=#D9822B;fontFamily=Inter;fontSize=13;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="486" y="300" width="238" height="51" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Patch tokens&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;14 × 14 × 1024 (bỏ CLS)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3ECFA;strokeColor=#3A6BC4;fontFamily=Inter;fontSize=13;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="486" y="420" width="238" height="51" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;LayerNorm → reshape&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;lưới 14×14×1024&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEBD8;strokeColor=#D9822B;fontFamily=Inter;fontSize=13;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="800" y="130" width="226" height="51" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;DWConv 3×3 → GELU&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;ngữ cảnh patch lân cận&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEBD8;strokeColor=#D9822B;fontFamily=Inter;fontSize=13;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="800" y="196" width="226" height="51" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Conv 1×1: 1024→256 → GELU&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEBD8;strokeColor=#D9822B;fontFamily=Inter;fontSize=13;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="800" y="262" width="226" height="40" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Conv 1×1: 256→1&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEBD8;strokeColor=#D9822B;fontFamily=Inter;fontSize=13;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="800" y="320" width="226" height="40" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Bản đồ logit patch s&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;s ∈ R^(14×14) mỗi tile&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F4EA;strokeColor=#2F8F5B;fontFamily=Inter;fontSize=13;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1080" y="120" width="210" height="51" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;MIL pooling (LSE, r = 5)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;z = (1/r)·log mean exp(r·s)&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;gộp mọi patch của mọi tile&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEBD8;strokeColor=#D9822B;fontFamily=Inter;fontSize=13;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1080" y="250" width="210" height="68" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;P(fake) = σ(z − α)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;α = 0 mặc định (ngưỡng 0.5)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F4EA;strokeColor=#2F8F5B;fontFamily=Inter;fontSize=13;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1330" y="258" width="200" height="51" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Heatmap vùng nghi sinh&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;upsample s về kích thước ảnh&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F4EA;strokeColor=#2F8F5B;fontFamily=Inter;fontSize=13;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1330" y="120" width="200" height="51" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Nhánh phụ: GAP → Linear&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;logit z_gap (chỉ dùng khi train)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEBD8;strokeColor=#D9822B;fontFamily=Inter;fontSize=13;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="800" y="470" width="226" height="51" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;L = L_img + 0.5·L_gap + 0.5·L_neg + 0.2·L_pix&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;L_img: BCE(z, y)      L_gap: BCE(z_gap, y)&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;L_neg: mọi patch của ảnh real → 0 (không cần mask)&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;L_pix: BCE patch với mask (chỉ fake có mask, tùy chọn)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE3E6;strokeColor=#C2414F;fontFamily=Inter;fontSize=13;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1098" y="446" width="414" height="85" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Expert low-level&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;SRM/NPR residual → ResNet18 (scratch)&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;FiLM điều kiện: bảng lượng tử JPEG kênh Y (64)&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;+ cờ &amp;quot;không nén&amp;quot; → logit z_low&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEBD8;strokeColor=#D9822B;fontFamily=Inter;fontSize=13;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="48" y="668" width="330" height="85" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Expert patch = CAPD (logit z)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F4EA;strokeColor=#2F8F5B;fontFamily=Inter;fontSize=13;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="48" y="790" width="330" height="44" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Meta-features (không nhãn)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;chất lượng/QT, kích thước ảnh,&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;bất đồng giữa expert, % patch nghi&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F3F7;strokeColor=#2C8AA6;fontFamily=Inter;fontSize=13;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="420" y="700" width="330" height="68" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Gate MLP → trọng số softmax&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;train bằng stacking trên val&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;khác generator (không end-to-end)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEBD8;strokeColor=#D9822B;fontFamily=Inter;fontSize=13;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="800" y="700" width="300" height="68" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Logit hợp nhất → hiệu chỉnh&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;temperature trên val + α không nhãn&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;(bỏ qua nếu logit không hai đỉnh)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F4EA;strokeColor=#2F8F5B;fontFamily=Inter;fontSize=13;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="1150" y="700" width="350" height="68" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3ECFA;strokeColor=#3A6BC4;fontFamily=Inter;fontSize=13;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="100" y="588" width="22" height="16" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEBD8;strokeColor=#D9822B;fontFamily=Inter;fontSize=13;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="250" y="588" width="22" height="16" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F4EA;strokeColor=#2F8F5B;fontFamily=Inter;fontSize=13;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="400" y="588" width="22" height="16" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE3E6;strokeColor=#C2414F;fontFamily=Inter;fontSize=13;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x