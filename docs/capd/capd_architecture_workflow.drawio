e=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4A4A48;strokeWidth=1.5;fontFamily=Inter;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=1;" edge="1" parent="1" source="c26" target="c27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c55" value="Chú thích:" style="text;html=1;align=left;fontSize=12.5;fontColor=#333;fontFamily=Inter;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="24" y="586" width="380" height="20" as="geometry"/></mxCell><mxCell id="c56" value="đóng băng" style="text;html=1;align=left;fontSize=12;fontColor=#333;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="130" y="587" width="380" height="20" as="geometry"/></mxCell><mxCell id="c57" value="được train" style="text;html=1;align=left;fontSize=12;fontColor=#333;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="280" y="587" width="380" height="20" as="geometry"/></mxCell><mxCell id="c58" value="đầu ra" style="text;html=1;align=left;fontSize=12;fontColor=#333;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="430" y="587" width="380" height="20" as="geometry"/></mxCell><mxCell id="c59" value="loss" style="text;html=1;align=left;fontSize=12;fontColor=#333;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="580" y="587" width="380" height="20" as="geometry"/></mxCell><mxCell id="c60" value="đầu vào / xử lý" style="text;html=1;align=left;fontSize=12;fontColor=#333;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="730" y="587" width="380" height="20" as="geometry"/></mxCell><mxCell id="c61" value="Nét đứt: chỉ dùng khi train hoặc thuộc phần mở rộng" style="text;html=1;align=left;fontSize=12;fontColor=#555;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="860" y="587" width="380" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="Workflow CAPD" name="Workflow CAPD"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="1040"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="CAPD — workflow: dữ liệu → train → đánh giá" style="text;html=1;fontSize=22;fontStyle=1;fontFamily=Inter;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1000" height="34" as="geometry"/></mxCell><mxCell id="c2" value="① Dữ liệu (đã có trên Kaggle + tự sinh)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#EFE8FB;strokeColor=#7A57C9;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fontSize=14;fontColor=#7A57C9;fontFamily=Inter;opacity=60;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="360" height="640" as="geometry"/></mxCell><mxCell id="c3" value="② Ghép cặp, codec, kiểm tra shortcut" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E6F3F7;strokeColor=#2C8AA6;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fontSize=14;fontColor=#2C8AA6;fontFamily=Inter;opacity=60;" vertex="1" parent="1"><mxGeometry x="410" y="60" width="360" height="640" as="geometry"/></mxCell><mxCell id="c4" value="③ Train (Kaggle 2×T4)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FDEBD8;strokeColor=#D9822B;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fontSize=14;fontColor=#D9822B;fontFamily=Inter;opacity=60;" vertex="1" parent="1"><mxGeometry x="800" y="60" width="360" height="640" as="geometry"/></mxCell><mxCell id="c5" value="④ Đánh giá (một model, không tune đích)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E2F4EA;strokeColor=#2F8F5B;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fontSize=14;fontColor=#2F8F5B;fontFamily=Inter;opacity=60;" vertex="1" parent="1"><mxGeometry x="1190" y="60" width="390" height="640" as="geometry"/></mxCell><mxCell id="c6" value="⑤ Ablation, so sánh baseline, mở rộng" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F7F7F5;strokeColor=#8A8A85;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fontSize=14;fontColor=#8A8A85;fontFamily=Inter;opacity=60;" vertex="1" parent="1"><mxGeometry x="20" y="730" width="1560" height="290" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Real&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;ImageNet + COCO (manifest 200K)&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;real COCO của B-Free&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFE8FB;strokeColor=#7A57C9;fontFamily=Inter;fontSize=13;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="320" height="68" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Real chất lượng cao&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;RAISE + FFHQ chưa nén&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;(một phần train, phần còn lại test)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFE8FB;strokeColor=#7A57C9;fontFamily=Inter;fontSize=13;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="320" height="68" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Fake B-Free (SD2.1)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;self-conditioned, inpainted,&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;inpainted + origBG (cùng COCO ID)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFE8FB;strokeColor=#7A57C9;fontFamily=Inter;fontSize=13;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="316" width="320" height="68" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Fake tái tạo VAE (~20k)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;SD2.1 / SDXL / FLUX: encode → decode&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFE8FB;strokeColor=#7A57C9;fontFamily=Inter;fontSize=13;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="432" width="320" height="51" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Inpaint-exchange tự sinh (~10k)&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;mask 2–40%, dán lại pixel gốc&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;có mask → dùng cho L_pix&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFE8FB;strokeColor=#7A57C9;fontFamily=Inter;fontSize=13;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="530" width="320" height="68" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Ghép cặp real–fake&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;theo source ID (COCO ID)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F3F7;strokeColor=#2C8AA6;fontFamily=Inter;fontSize=13;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="430" y="100" width="320" height="51" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Codec aug DÙNG CHUNG cho cả cặp&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;20% giữ nguyên · 50% JPEG Q60–100&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;10% WebP · 20% resize 0.5–1.5 + JPEG&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F3F7;strokeColor=#2C8AA6;fontFamily=Inter;fontSize=13;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="430" y="200" width="320" height="68" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Lấy mẫu cân bằng&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;50% real / 50% fake; fake: 35% self-cond,&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;35% inpaint (½ origBG), 20% VAE, 10% exch.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F3F7;strokeColor=#2C8AA6;fontFamily=Inter;fontSize=13;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="430" y="330" width="320" height="68" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Luật shortcut ≤ 60%?&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;(chỉ số token / chỉ QT)&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#B88A00;fontFamily=Inter;fontSize=13;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="470" y="470" width="240" height="120" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Smoke run&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;2k ảnh, 1 epoch: đo VRAM, tốc độ,&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;kiểm tra loss giảm&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEBD8;strokeColor=#D9822B;fontFamily=Inter;fontSize=13;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="820" y="100" width="320" height="68" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Train đầy đủ&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;fp16 · DDP · grad checkpointing&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;AdamW (LoRA 1e-4, head 1e-3), cosine&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;3–5 epoch · seed 42 / 43 / 44&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEBD8;strokeColor=#D9822B;fontFamily=Inter;fontSize=13;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="820" y="216" width="320" height="85" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Validation mỗi epoch&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;B-Free valid + RAISE held-out&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEBD8;strokeColor=#D9822B;fontFamily=Inter;fontSize=13;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="820" y="356" width="320" height="51" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Chọn checkpoint&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;AUC trung bình + FPR real không nén&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;(không chọn theo Tiny / test)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEBD8;strokeColor=#D9822B;fontFamily=Inter;fontSize=13;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="820" y="456" width="320" height="68" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Cohort test&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;Tiny 7 gen: raw / fake-JPEG96 / resize256+JPEG96&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;CommFor cân bằng 2.000 ảnh&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;B-Free valid 6 nhánh (gồm origBG)&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;INP-X: INP và INP-X&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;Synthbuster / Chameleon (nếu có)&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;RAISE / FFHQ held-out (FPR)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F4EA;strokeColor=#2F8F5B;fontFamily=Inter;fontSize=13;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1210" y="100" width="350" height="136" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Chỉ số&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;AUC · AP · BA@0.5 · Real/Fake-acc&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;TPR@FPR 1% / 5% · worst-case&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;bootstrap CI qua 3 seed&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F4EA;strokeColor=#2F8F5B;fontFamily=Inter;fontSize=13;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1210" y="290" width="350" height="85" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Đạt mục tiêu?&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;CommFor ≥ AIDE Full&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;origBG recall ≥ GSD + 20&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF6D6;strokeColor=#B88A00;fontFamily=Inter;fontSize=13;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1255" y="430" width="260" height="140" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Train lại baseline trên CÙNG dữ liệu&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;CLIP-LP · NPR-ResNet18 · GSD&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;→ kiểm chứng &amp;quot;dữ liệu &amp;gt; kiến trúc&amp;quot;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F3F7;strokeColor=#2C8AA6;fontFamily=Inter;fontSize=13;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="780" width="360" height="68" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Ablation CAPD&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;head: CLS / GAP / PatchHead / +MIL&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;có/không origBG · λ_pix = 0 / 0.2&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;codec ghép cặp / độc lập · real không nén&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;DINOv3 / DINOv2 / CLIP-L · tiling / resize&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F3F7;strokeColor=#2C8AA6;fontFamily=Inter;fontSize=13;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="440" y="780" width="420" height="102" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Bảng kết quả cuối&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;CAPD vs CLIP, NPR, AIDE, GSD&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;trung bình + worst-case&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F4EA;strokeColor=#2F8F5B;fontFamily=Inter;fontSize=13;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="900" y="800" width="250" height="68" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Mở rộng B: Gated-Experts&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;chỉ khi oracle gain &amp;gt; 3 điểm&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F7F5;strokeColor=#8A8A85;fontFamily=Inter;fontSize=13;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry x="1240" y="800" width="320" height="51" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Phân tích lỗi&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:12px"&gt;xem heatmap, sửa dữ liệu / head&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE3E6;strokeColor=#C2414F;fontFamily=Inter;fontSize=13;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1240" y="930" width="320