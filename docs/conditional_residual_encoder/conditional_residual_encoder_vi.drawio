  <diagram id="03_losses" name="03 - Công thức loss">
    <mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1800" pageHeight="2060" math="0" background="#f8fafc">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="LOSS: CHẤM ĐIỂM DỰ ĐOÁN VÀ GIỮ EMBEDDING CÓ THÔNG TIN" vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=32;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=15;fontStyle=1;text;strokeColor=none;fillColor=none;">
          <mxGeometry x="45" y="25" width="1710" height="60" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Công thức trong file này dùng text chỉnh sửa được. File loss_explained_vi.md có công thức LaTeX và giải thích đầy đủ." vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=21;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=15;fontStyle=0;text;strokeColor=none;fillColor=none;">
          <mxGeometry x="45" y="90" width="1710" height="70" as="geometry" />
        </mxCell>
        <mxCell id="vars" value="TỪ ĐIỂN BIẾN&#10;B: số ảnh/batch; v thuộc {A,B}: nhóm context; t=1..2: target patch; q=1..16: ô/target; j=1..24: thống kê.&#10;z_A,z_B: bản mô tả 64 số từ hai nhóm context; c: 5 đặc điểm thô của ô target; y: đáp án 24 thống kê đã chuẩn hóa.&#10;μ: giá trị trung tâm predictor đoán; s: log-variance predictor đoán; θ: encoder weights; ψ: predictor weights.&#10;D=64: chiều embedding; ε=1e-4: số nhỏ trong variance regularizer; các mean/covariance bên dưới tính theo batch ảnh." vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=22;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=15;fontStyle=0;rounded=1;fillColor=#e2e8f0;strokeColor=#94a3b8;strokeWidth=1.5;">
          <mxGeometry x="45" y="175" width="1710" height="180" as="geometry" />
        </mxCell>
        <mxCell id="pred" value="1. LOSS CHÍNH — DỰ ĐOÁN PHÂN PHỐI CỦA LABEL&#10;ℓ = 0,5 × [ exp(−s) × (y − μ)² + s ]&#10;L_pred = mean ℓ trên mọi ảnh B, cả hai context A/B, 2 target, 16 ô và 24 thống kê.&#10;μ và s = P_ψ(z_v, c). Dùng s sau clamp [-6,6]; label y không có gradient.&#10;(y−μ)²: đoán sai bị phạt. exp(−s): đoán quá tự tin mà sai bị phạt mạnh. +s: ngăn tăng variance vô hạn.&#10;Có thể bỏ hằng số 0,5 log(2π). NLL không nhất thiết không âm; loss âm không tự có nghĩa training bị lỗi." vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=23;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=15;fontStyle=0;rounded=1;fillColor=#ffedd5;strokeColor=#94a3b8;strokeWidth=1.5;">
          <mxGeometry x="45" y="405" width="1710" height="240" as="geometry" />
        </mxCell>
        <mxCell id="inv" value="2. INVARIANCE — HAI NHÓM CÙNG ẢNH CẦN TƯƠNG ĐỒNG&#10;L_inv = mean_(b,k) [ z_A[b,k] − z_B[b,k] ]²&#10;b là chỉ số ảnh; k=1..64 là chiều embedding. Mean = tổng chia B×64.&#10;Nếu chỉ dùng loss này, model có thể xuất một vector giống hệt cho mọi ảnh → mất thông tin." vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=23;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=15;fontStyle=0;rounded=1;fillColor=#ffedd5;strokeColor=#94a3b8;strokeWidth=1.5;">
          <mxGeometry x="45" y="700" width="1710" height="170" as="geometry" />
        </mxCell>
        <mxCell id="var" value="3. VARIANCE FLOOR — GIỮ SỰ ĐA DẠNG GIỮA CÁC ẢNH&#10;v(Z) = (1/D) Σ_k max(0, 1 − sqrt(Var_batch(Z[:,k]) + ε))&#10;L_var = [ v(Z_A) + v(Z_B) ] / 2&#10;Z_A và Z_B là ma trận B×64; mỗi hàng là embedding của một ảnh.&#10;Nếu một chiều gần như giống nhau trên mọi ảnh, std nhỏ hơn1 → bị phạt. Dùng sample variance, mẫu số B−1.&#10;Không L2-normalize z trước term này; B≥2, pilot khuyên B64. Chống collapse không chứng minh học đúng forensic." vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=22;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=15;fontStyle=0;rounded=1;fillColor=#ffedd5;strokeColor=#94a3b8;strokeWidth=1.5;">
          <mxGeometry x="45" y="925" width="1710" height="225" as="geometry" />
        </mxCell>
        <mxCell id="cov" value="4. COVARIANCE — GIẢM CÁC CHIỀU TRÙNG THÔNG TIN&#10;Z_centered = Z − mean_batch(Z)&#10;C(Z) = Z_centeredᵀ Z_centered / (B−1)&#10;cov_penalty(Z) = (1/D) Σ_(k≠l) C(Z)[k,l]²&#10;L_cov = cov_penalty(Z_A) + cov_penalty(Z_B)&#10;C(Z) kích thước64×64; bỏ đường chéo. Các chiều cùng tăng/giảm theo nhau bị phạt. Không ép từng ảnh thành Gaussian." vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=23;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=15;fontStyle=0;rounded=1;fillColor=#ffedd5;strokeColor=#94a3b8;strokeWidth=1.5;">
          <mxGeometry x="45" y="1205" width="1710" height="240" as="geometry" />
        </mxCell>
        <mxCell id="total" value="5. LOSS TỔNG — RECIPE THỬ NGHIỆM&#10;L_total = L_pred + λ × (25 L_inv + 25 L_var + L_cov)&#10;Bắt đầu λ=0,1; chạy đối chứng λ=0. Không coi các hệ số này là đã tối ưu cho forensic.&#10;Backprop qua predictor → z → encoder. Không update FRE, label statistics hoặc RGB conditions." vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=24;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=15;fontStyle=1;rounded=1;fillColor=#ffedd5;strokeColor=#94a3b8;strokeWidth=1.5;">
          <mxGeometry x="45" y="1500" width="1710" height="155" as="geometry" />
        </mxCell>
        <mxCell id="example" value="VÍ DỤ NLL MỘT CHIỀU — CHỈ MINH HỌA, KHÔNG PHẢI KẾT QUẢ TRAIN&#10;Label y=2. Model đoán μ=1 và variance=1 → s=0 → ℓ=0,5.&#10;Giữ μ=1 nhưng đoán variance=4 → s=log4 → ℓ≈0,818: tăng độ bất định không miễn phí.&#10;Một chiều không đại diện toàn loss; phải lấy mean đúng các trục đã ghi." vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=23;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=15;fontStyle=0;rounded=1;fillColor=#fef3c7;strokeColor=#94a3b8;strokeWidth=1.5;">
          <mxGeometry x="45" y="1710" width="1710" height="170" as="geometry" />
        </mxCell>
        <mxCell id="warning" value="LOSS GIẢM CHỈ CHỨNG MINH MODEL LÀM BÀI TẬP TỐT HƠN.&#10;Cần kiểm tra c-only, hoán đổi z, unseen camera/source và unseen generators để chứng minh ích lợi cho detection." vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=23;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=15;fontStyle=1;text;strokeColor=none;fillColor=none;">
          <mxGeometry x="45" y="1920" width="1710" height="95" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="04_training_and_gmm" name="04 - Train và GMM">
    <mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1800" pageHeight="1630" math="0" background="#f8fafc">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="TỪ MỘT BƯỚC TRAIN ĐẾN ĐÁNH GIÁ ẢNH MỚI" vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=32;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=15;fontStyle=1;text;strokeColor=none;fillColor=none;">
          <mxGeometry x="45" y="25" width="1710" height="60" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Phân biệt: học encoder/predictor trước; fit density sau. Không dùng final-test để lựa model hoặc threshold." vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=21;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=15;fontStyle=0;text;strokeColor=none;fillColor=none;">
          <mxGeometry x="45" y="90" width="1710" height="70" as="geometry" />
        </mxCell>
        <mxCell id="tr" value="A. HỌC BẰNG ẢNH THẬT" vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=25;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=15;fontStyle=1;text;strokeColor=none;fillColor=none;">
          <mxGeometry x="45" y="165" width="800" height="55" as="geometry" />
        </mxCell>
        <mxCell id="inf" value="B. FREEZE VÀ XÂY DETECTOR" vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=25;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=15;fontStyle=1;text;strokeColor=none;fillColor=none;">
          <mxGeometry x="945" y="165" width="800" height="55" as="geometry" />
        </mxCell>
        <mxCell id="d" value="REAL ENCODER-TRAIN&#10;Native crop256; không resize để ép đủ kích thước&#10;Sampling A3 + B3 + target2; label chuẩn hóa cố định" vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=21;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=15;fontStyle=0;rounded=1;fillColor=#dbeafe;strokeColor=#94a3b8;strokeWidth=1.5;">
          <mxGeometry x="75" y="245" width="740" height="105" as="geometry" />
        </mxCell>
        <mxCell id="f" value="FORWARD&#10;R frozen → context encoder E → z_A,z_B&#10;P(z_A,c), P(z_B,c) → μ,s&#10;Tự tính đáp án y từ residual target" vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=21;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=15;fontStyle=0;rounded=1;fillColor=#ede9fe;strokeColor=#94a3b8;strokeWidth=1.5;">
          <mxGeometry x="75" y="410" width="740" height="115" as="geometry" />
        </mxCell>
        <mxCell id="l" value="LOSS TỔNG&#10;Prediction NLL + invariance + variance + covariance&#10;Tính label statistics / loss nhạy số học bằng FP32" vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=21;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=15;fontStyle=0;rounded=1;fillColor=#ffedd5;strokeColor=#94a3b8;strokeWidth=1.5;">
          <mxGeometry x="75" y="585" width="740" height="100" as="geometry" />
        </mxCell>
        <mxCell id="update" value="BACKWARD VÀ ADAMW UPDATE&#10;Update θ (encoder) và ψ (predictor)&#10;Không có BCE real/fake hoặc generator label" vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=21;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=15;fontStyle=0;rounded=1;fillColor=#ede9fe;strokeColor=#94a3b8;strokeWidth=1.5;">
          <mxGeometry x="75" y="745" width="740" height="100" as="geometry" />
        </mxCell>
        <mxCell id="val" value="REAL VALIDATION — FIXED PATCH LAYOUT&#10;So prediction NLL; std/effective rank của z&#10;So predictor c-only và predictor với z bị hoán đổi&#10;Loss tốt không đảm bảo AUROC unseen tốt" vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=21;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=15;fontStyle=0;rounded=1;fillColor=#fef3c7;strokeColor=#94a3b8;strokeWidth=1.5;">
          <mxGeometry x="75" y="905" width="740" height="140" as="geometry" />
        </mxCell>
        <mxCell id="recipe" value="PILOT ĐỀ XUẤT — CHƯA BENCHMARK&#10;Batch64 ảnh; AdamW LR1e-4, WD1e-4&#10;20 epochs; warmup5% rồi cosine đến LR1e-6&#10;Shared flip/rotation90°; chưa thêm JPEG/blur&#10;Khóa seed, data membership và cách chọn checkpoint" vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=21;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=15;fontStyle=0;rounded=1;fillColor=#e2e8f0;strokeColor=#94a3b8;strokeWidth=1.5;">
          <mxGeometry x="75" y="1105" width="740" height="170" as="geometry" />
        </mxCell>
        <mxCell id="freeze" value="FREEZE ENCODER E VÀ PREDICTOR P&#10;Giữ cả predictor để đo surprise&#10;Khóa sampling / preprocessing / label scaler" vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=21;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=15;fontStyle=0;rounded=1;fillColor=#e2e8f0;strokeColor=#94a3b8;strokeWidth=1.5;">
          <mxGeometry x="975" y="245" width="740" height="100" as="geometry" />
        </mxCell>
        <mxCell id="surprise" value="ĐO SAI SỐ PHÂN PHỐI TRÊN REAL-FIT&#10;a[v,t,q,j] = 0,5 × [exp(−s) × (y−μ)² + s]&#10;Với mỗi chiều j: lấy mean và std qua v,t,q&#10;h = [mean24 ; std24] → embedding48" vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=21;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=15;fontStyle=0;rounded=1;fillColor=#dcfce7;strokeColor=#94a3b8;strokeWidth=1.5;">
          <mxGeometry x="975" y="405" width="740" height="140" as="geometry" />
        </mxCell>
        <mxCell id="gauss" value="FIT GAUSSIAN/GMM TRÊN h CỦA REAL-FIT&#10;Bắt đầu K=1, full covariance + regularization&#10;Fit bằng real-fit, không dùng calibration/test" vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=21;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=15;fontStyle=0;rounded=1;fillColor=#ede9fe;strokeColor=#94a3b8;strokeWidth=1.5;">
          <mxGeometry x="975" y="605" width="740" height="105" as="geometry" />
        </mxCell>
        <mxCell id="cal" value="REAL-CALIBRATION RIÊNG&#10;score = −log p_GMM(h)&#10;Ngưỡng τ = percentile95 của calibration scores&#10;Nhắm empirical FPR5% trên calibration" vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=21;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=15;fontStyle=0;rounded=1;fillColor=#e2e8f0;strokeColor=#94a3b8;strokeWidth=1.5;">
          <mxGeometry x="975" y="770" width="740" height="130" as="geometry" />
        </mxCell>
        <mxCell id="test" value="ẢNH MỚI → CÙNG E/P → h → score&#10;score &gt; τ: bất thường so với real reference&#10;Không tự đồng nhất score với P(fake)&#10;Report real FPR và unseen-fake TPR/AUROC" vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=21;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=15;fontStyle=0;rounded=1;fillColor=#dbeafe;strokeColor=#94a3b8;strokeWidth=1.5;">
          <mxGeometry x="975" y="940" width="740" height="120" as="geometry" />
        </mxCell>
        <mxCell id="audit" value="THÍ NGHIỆM QUYẾT ĐỊNH&#10;1. Predictor chỉ dùng c&#10;2. Predictor dùng c + đúng z&#10;3. Predictor dùng c + z từ ảnh khác&#10;Đúng z phải có ích trên validation và detection." vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=21;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=15;fontStyle=0;rounded=1;fillColor=#fef3c7;strokeColor=#94a3b8;strokeWidth=1.5;">
          <mxGeometry x="975" y="1120" width="740" height="155" as="geometry" />
        </mxCell>
        <mxCell id="split" value="TÁCH DỮ LIỆU THEO ẢNH GỐC&#10;Encoder-train / encoder-validation / real-density-fit / real-calibration / final-test.&#10;Mọi crop hoặc biến thể của một ảnh phải cùng split. Final-test gồm real mới + fake unseen generators." vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=22;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=15;fontStyle=0;rounded=1;fillColor=#fef3c7;strokeColor=#94a3b8;strokeWidth=1.5;">
          <mxGeometry x="75" y="1340" width="1640" height="105" as="geometry" />
        </mxCell>
        <mxCell id="gsd" value="GSD KHÔNG CÓ TRONG BẢN CNN V1 NÀY. Nếu thay context CNN bằng CLIP+GSD, phải thiết kế lại input size và tensor contract.&#10;Không chiếu trực tiếp CNN feature128 bằng semantic basis CLIP1024. Bản GSD là một thí nghiệm mở rộng riêng." vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=21;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=15;fontStyle=0;text;strokeColor=none;fillColor=none;">
          <mxGeometry x="75" y="1490" width="1640" height="100" as="geometry" />
        </mxCell>
