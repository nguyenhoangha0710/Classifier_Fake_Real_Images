        <mxCell id="edge5" source="mlp" target="pred" edge="1" parent="1" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#64748b;dashed=0;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points" />
          </mxGeometry>
        </mxCell>
        <mxCell id="edge6" source="r" target="stat" edge="1" parent="1" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#64748b;dashed=0;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points" />
          </mxGeometry>
        </mxCell>
        <mxCell id="edge7" source="stat" target="normalize" edge="1" parent="1" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#64748b;dashed=0;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points" />
