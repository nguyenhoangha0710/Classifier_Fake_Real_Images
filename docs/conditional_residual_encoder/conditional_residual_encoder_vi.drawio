        <mxCell id="subtitle" value="Bản thiết kế nghiên cứu v1 • Chỉ dùng ảnh thật để train • Chưa được thực nghiệm xác nhận" vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=21;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=15;fontStyle=0;text;strokeColor=none;fillColor=none;">
          <mxGeometry x="45" y="90" width="1710" height="70" as="geometry" />
        </mxCell>
        <mxCell id="image" value="Ảnh thật RGB&#10;B × 3 × 256 × 256" vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=22;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=15;fontStyle=0;rounded=1;fillColor=#dbeafe;strokeColor=#94a3b8;strokeWidth=1.5;">
          <mxGeometry x="650" y="170" width="500" height="100" as="geometry" />
        </mxCell>
        <mxCell id="fre" value="BỘ LỌC PHẦN DƯ R — FROZEN&#10;Grayscale → FRE 1→8 channels&#10;Output: B × 8 × 256 × 256" vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=22;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=15;fontStyle=0;rounded=1;fillColor=#e2e8f0;strokeColor=#94a3b8;strokeWidth=1.5;">
          <mxGeometry x="90" y="320" width="680" height="100" as="geometry" />
        </mxCell>
        <mxCell id="condition" value="ĐIỀU KIỆN CỤC BỘ c — KHÔNG HỌC&#10;Low-pass RGB; mỗi ô target lấy 5 số:&#10;mean R/G/B, độ biến động sáng, năng lượng cạnh" vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=22;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=15;fontStyle=0;rounded=1;fillColor=#e2e8f0;strokeColor=#94a3b8;strokeWidth=1.5;">
          <mxGeometry x="1050" y="320" width="660" height="130" as="geometry" />
        </mxCell>
        <mxCell id="sample" value="CHỌN 8 PATCH 64×64 KHÔNG GIAO NHAU&#10;3 context A + 3 context B + 2 target&#10;Giữ khoảng trống ≥16 px với FRE kernel15" vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=22;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=15;fontStyle=0;rounded=1;fillColor=#e2e8f0;strokeColor=#94a3b8;strokeWidth=1.5;">
          <mxGeometry x="90" y="490" width="680" height="100" as="geometry" />
        </mxCell>
        <mxCell id="a" value="CONTEXT A&#10;B × 3 × 8 × 64 × 64&#10;Những miếng được xem" vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=20;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=15;fontStyle=0;rounded=1;fillColor=#dbeafe;strokeColor=#94a3b8;strokeWidth=1.5;">
          <mxGeometry x="45" y="660" width="340" height="100" as="geometry" />
        </mxCell>
        <mxCell id="b" value="CONTEXT B&#10;B × 3 × 8 × 64 × 64&#10;Nhóm xem thứ hai" vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=20;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=15;fontStyle=0;rounded=1;fillColor=#dbeafe;strokeColor=#94a3b8;strokeWidth=1.5;">
          <mxGeometry x="425" y="660" width="340" height="100" as="geometry" />
        </mxCell>
        <mxCell id="target" value="TARGET RESIDUAL&#10;B × 2 × 8 × 64 × 64&#10;Không vào encoder" vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=20;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=15;fontStyle=0;rounded=1;fillColor=#dcfce7;strokeColor=#94a3b8;strokeWidth=1.5;">
          <mxGeometry x="825" y="660" width="340" height="100" as="geometry" />
        </mxCell>
        <mxCell id="ct" value="c: B × 2 × 16 × 5&#10;2 target; 16 ô/target&#10;Chỉ đặc điểm ảnh thô" vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=20;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=15;fontStyle=0;rounded=1;fillColor=#e2e8f0;strokeColor=#94a3b8;strokeWidth=1.5;">
          <mxGeometry x="1250" y="660" width="480" height="100" as="geometry" />
        </mxCell>
        <mxCell id="encoder" value="SHARED ENCODER E — ĐƯỢC TRAIN&#10;Patch CNN → pooling từng patch → pooling cả nhóm&#10;Hai nhóm A/B dùng chung trọng số" vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=22;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=15;fontStyle=0;rounded=1;fillColor=#ede9fe;strokeColor=#94a3b8;strokeWidth=1.5;">
          <mxGeometry x="45" y="820" width="720" height="110" as="geometry" />
        </mxCell>
        <mxCell id="label" value="LABEL y — TỰ TÍNH&#10;16 ô 16×16/target&#10;8 energy + 8 corr ngang&#10;+ 8 corr dọc = 24 số&#10;B × 2 × 16 × 24" vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=20;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=15;fontStyle=0;rounded=1;fillColor=#dcfce7;strokeColor=#94a3b8;strokeWidth=1.5;">
          <mxGeometry x="825" y="820" width="340" height="145" as="geometry" />
        </mxCell>
        <mxCell id="za" value="z_A: B × 64&#10;Bản mô tả từ context A" vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=20;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=15;fontStyle=0;rounded=1;fillColor=#ede9fe;strokeColor=#94a3b8;strokeWidth=1.5;">
          <mxGeometry x="45" y="1000" width="340" height="80" as="geometry" />
        </mxCell>
        <mxCell id="zb" value="z_B: B × 64&#10;Bản mô tả từ context B" vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=20;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=15;fontStyle=0;rounded=1;fillColor=#ede9fe;strokeColor=#94a3b8;strokeWidth=1.5;">
          <mxGeometry x="425" y="1000" width="340" height="80" as="geometry" />
        </mxCell>
        <mxCell id="pred" value="BỘ DỰ ĐOÁN P — ĐƯỢC TRAIN&#10;Nối z (64 số) với c (5 số)&#10;MLP 69→128→128→48&#10;Dùng chung cho A và B" vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=21;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=15;fontStyle=0;rounded=1;fillColor=#ede9fe;strokeColor=#94a3b8;strokeWidth=1.5;">
          <mxGeometry x="1230" y="840" width="500" height="140" as="geometry" />
        </mxCell>
        <mxCell id="output" value="μ: 24 giá trị trung tâm dự đoán&#10;s: 24 log-variance dự đoán&#10;Mỗi context dự đoán cùng 2 target" vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=21;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=15;fontStyle=0;rounded=1;fillColor=#ede9fe;strokeColor=#94a3b8;strokeWidth=1.5;">
          <mxGeometry x="1230" y="1040" width="500" height="110" as="geometry" />
        </mxCell>
        <mxCell id="ssl" value="LOSS PHỤ TRÊN z_A VÀ z_B&#10;Cùng ảnh → tương đồng; giữa các ảnh → giữ thông tin&#10;Invariance + variance floor + covariance" vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=21;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=15;fontStyle=0;rounded=1;fillColor=#ffedd5;strokeColor=#94a3b8;strokeWidth=1.5;">
          <mxGeometry x="45" y="1160" width="720" height="105" as="geometry" />
        </mxCell>
        <mxCell id="nll" value="LOSS CHÍNH: CONDITIONAL GAUSSIAN NLL&#10;So μ, s dự đoán với label y đo từ target&#10;Dự đoán cả giá trị và độ dao động phù hợp" vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=21;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=15;fontStyle=0;rounded=1;fillColor=#ffedd5;strokeColor=#94a3b8;strokeWidth=1.5;">
          <mxGeometry x="825" y="1210" width="905" height="100" as="geometry" />
        </mxCell>
        <mxCell id="total" value="LOSS TỔNG = L_pred + 0,1 × (25 L_inv + 25 L_var + L_cov)&#10;Backprop chỉ cập nhật encoder E và predictor P" vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=23;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=15;fontStyle=1;rounded=1;fillColor=#ffedd5;strokeColor=#94a3b8;strokeWidth=1.5;">
          <mxGeometry x="300" y="1390" width="1200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="Xám: phép tính cố định / không nhận gradient • Tím: tham số được học • Xanh lá: đáp án tự tạo • Cam: loss&#10;B = số ảnh trong một batch. z là embedding học được, chưa chứng minh là thông số camera. Không có CLIP/GSD trong bản CNN này." vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=20;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=15;fontStyle=0;text;strokeColor=none;fillColor=none;">
