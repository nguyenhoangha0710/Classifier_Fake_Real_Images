        <mxCell id="title" value="ENCODER HỌC QUY LUẬT PHẦN DƯ CỦA ẢNH THẬT" vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=32;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=15;fontStyle=1;text;strokeColor=none;fillColor=none;">
