        </mxCell>
        <mxCell id="edge2" source="cnn" target="pool" edge="1" parent="1" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#64748b;dashed=0;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points" />
          </mxGeometry>
        </mxCell>
        <mxCell id="edge3" source="pool" target="set" edge="1" parent="1" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#64748b;dashed=0;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points" />
          </mxGeometry>
        </mxCell>
        <mxCell id="edge4" source="set" target="mlp" edge="1" parent="1" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#64748b;dashed=0;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points" />
