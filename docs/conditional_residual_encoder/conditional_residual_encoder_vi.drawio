  <diagram id="02_encoder_and_labels" name="02 - Encoder và label">
    <mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1800" pageHeight="1630" math="0" background="#f8fafc">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="BÊN TRONG ENCODER VÀ CÁCH TẠO ĐÁP ÁN" vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=32;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=15;fontStyle=1;text;strokeColor=none;fillColor=none;">
          <mxGeometry x="45" y="25" width="1710" height="60" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Encoder đọc context; đáp án lấy từ target khác vị trí. Mỗi ký hiệu đều gắn với một đối tượng cụ thể." vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=21;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=15;fontStyle=0;text;strokeColor=none;fillColor=none;">
          <mxGeometry x="45" y="90" width="1710" height="70" as="geometry" />
        </mxCell>
        <mxCell id="left" value="A. ENCODER — TỪ 3 PATCH ĐẾN 64 SỐ" vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=25;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=15;fontStyle=1;text;strokeColor=none;fillColor=none;">
          <mxGeometry x="45" y="165" width="810" height="55" as="geometry" />
        </mxCell>
        <mxCell id="right" value="B. LABEL — ĐO TRỰC TIẾP TỪ TARGET" vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=25;fontColor=#0f172a;align=left;verticalAlign=middle;spacing=15;fontStyle=1;text;strokeColor=none;fillColor=none;">
          <mxGeometry x="945" y="165" width="810" height="55" as="geometry" />
        </mxCell>
        <mxCell id="input" value="Một nhóm context: B × 3 × 8 × 64 × 64&#10;Gộp B và 3 patch để chạy chung CNN" vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=22;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=15;fontStyle=0;rounded=1;fillColor=#dbeafe;strokeColor=#94a3b8;strokeWidth=1.5;">
          <mxGeometry x="75" y="245" width="740" height="85" as="geometry" />
        </mxCell>
        <mxCell id="cnn" value="PATCH CNN — DÙNG CHUNG CHO TẤT CẢ PATCH&#10;Conv3×3, stride2, padding1 + GroupNorm8 + GELU&#10;8→32: 32×32; 32→64: 16×16&#10;64→128: 8×8; 128→128: 4×4&#10;Output mỗi patch: 128 × 4 × 4" vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=23;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=15;fontStyle=0;rounded=1;fillColor=#ede9fe;strokeColor=#94a3b8;strokeWidth=1.5;">
          <mxGeometry x="75" y="390" width="740" height="210" as="geometry" />
        </mxCell>
        <mxCell id="pool" value="SPATIAL POOLING TRONG MỖI PATCH&#10;Mean128 + std128 → 256 số&#10;Linear 256→128 → patch embedding128" vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=22;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=15;fontStyle=0;rounded=1;fillColor=#ede9fe;strokeColor=#94a3b8;strokeWidth=1.5;">
          <mxGeometry x="75" y="660" width="740" height="110" as="geometry" />
        </mxCell>
        <mxCell id="set" value="SET POOLING TRÊN 3 PATCH&#10;Mean128 + std128 → 256 số&#10;Không dùng thứ tự hoặc tọa độ patch làm input" vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=22;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=15;fontStyle=0;rounded=1;fillColor=#ede9fe;strokeColor=#94a3b8;strokeWidth=1.5;">
          <mxGeometry x="75" y="830" width="740" height="115" as="geometry" />
        </mxCell>
        <mxCell id="mlp" value="MLP 256→128→64, GELU ở lớp giữa&#10;z: B × 64 — không L2-normalize trước loss variance" vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=22;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=15;fontStyle=0;rounded=1;fillColor=#ede9fe;strokeColor=#94a3b8;strokeWidth=1.5;">
          <mxGeometry x="75" y="1005" width="740" height="100" as="geometry" />
        </mxCell>
        <mxCell id="pred" value="PREDICTOR CHO TỪNG Ô TARGET&#10;[z:64 ; c:5] → 69→128→128→48&#10;24 số μ + 24 số s = log(variance)&#10;s được clamp [-6, 6] trước NLL" vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=21;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=15;fontStyle=0;rounded=1;fillColor=#ede9fe;strokeColor=#94a3b8;strokeWidth=1.5;">
          <mxGeometry x="75" y="1165" width="740" height="125" as="geometry" />
        </mxCell>
        <mxCell id="r" value="Một target residual: 8 × 64 × 64&#10;Chia 4×4 ô; mỗi ô có 8 × 16 × 16 giá trị" vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=22;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=15;fontStyle=0;rounded=1;fillColor=#dcfce7;strokeColor=#94a3b8;strokeWidth=1.5;">
          <mxGeometry x="975" y="245" width="740" height="85" as="geometry" />
        </mxCell>
        <mxCell id="stat" value="MỖI Ô, MỖI RESIDUAL CHANNEL:&#10;1. e = log(mean(r²) + ε_E): độ lớn phần dư&#10;2. ρ_h = corr(pixel bên trái, pixel bên phải)&#10;3. ρ_v = corr(pixel phía trên, pixel phía dưới)&#10;8 channels × 3 thống kê = 24 số&#10;ε_E = 1e-8 với output FRE đã khóa scale" vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=22;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=15;fontStyle=0;rounded=1;fillColor=#dcfce7;strokeColor=#94a3b8;strokeWidth=1.5;">
          <mxGeometry x="975" y="390" width="740" height="220" as="geometry" />
        </mxCell>
        <mxCell id="normalize" value="CHUẨN HÓA LABEL BẰNG TRAIN STATISTICS&#10;y_j = (u_j − m_j) / max(a_j, 1e-3)&#10;u_j: thống kê thô; m_j: mean; a_j: std&#10;Chỉ ước lượng m, a từ ảnh thuộc encoder-train" vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=22;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=15;fontStyle=0;rounded=1;fillColor=#dcfce7;strokeColor=#94a3b8;strokeWidth=1.5;">
          <mxGeometry x="975" y="670" width="740" height="130" as="geometry" />
        </mxCell>
        <mxCell id="y" value="Đáp án cuối y: B × 2 × 16 × 24&#10;B ảnh; 2 target; 16 ô; 24 thống kê" vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=22;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=15;fontStyle=0;rounded=1;fillColor=#dcfce7;strokeColor=#94a3b8;strokeWidth=1.5;">
          <mxGeometry x="975" y="860" width="740" height="85" as="geometry" />
        </mxCell>
        <mxCell id="c" value="ĐIỀU KIỆN c: B × 2 × 16 × 5&#10;Từ RGB low-pass bằng average filter7×7&#10;Mean R/G/B; std luminance; gradient energy&#10;Luminance = 0,299R + 0,587G + 0,114B&#10;Không đưa residual target vào predictor" vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=21;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=15;fontStyle=0;rounded=1;fillColor=#e2e8f0;strokeColor=#94a3b8;strokeWidth=1.5;">
          <mxGeometry x="975" y="1005" width="740" height="150" as="geometry" />
        </mxCell>
        <mxCell id="sample" value="SAMPLING TRÊN NATIVE CROP256&#10;9 vị trí: x,y thuộc {0,80,160}; mỗi core64&#10;Random chọn 8 core: A3, B3, target2&#10;Gap16 hạn chế chia sẻ receptive field của FRE15&#10;Giữ target/cùng tọa độ khi lấy RGB conditions" vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=21;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=15;fontStyle=0;rounded=1;fillColor=#fef3c7;strokeColor=#94a3b8;strokeWidth=1.5;">
          <mxGeometry x="975" y="1215" width="740" height="160" as="geometry" />
        </mxCell>
        <mxCell id="note" value="TẠI SAO LABEL KHÔNG ĐƯỢC HỌC?&#10;Nếu encoder và bộ tạo đáp án cùng tự do, chúng có thể cùng đổi để bài tập trở nên tầm thường.&#10;FRE, thống kê label, chuẩn hóa label và phép lấy conditions đều cố định / stop-gradient.&#10;Residual vẫn có thể chứa texture; 24 thống kê là thiết kế pilot, chưa phải mô tả đầy đủ quá trình tạo ảnh." vertex="1" parent="1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=22;fontColor=#0f172a;align=center;verticalAlign=middle;spacing=15;fontStyle=0;rounded=1;fillColor=#fef3c7;strokeColor=#94a3b8;strokeWidth=1.5;">
          <mxGeometry x="75" y="1415" width="1640" height="150" as="geometry" />
        </mxCell>
        <mxCell id="edge1" source="input" target="cnn" edge="1" parent="1" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#64748b;dashed=0;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points" />
