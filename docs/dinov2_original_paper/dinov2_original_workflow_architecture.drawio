"1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge20" source="ema" target="tvit" edge="1" parent="1" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#8b5cc6;dashed=1;exitX=0.23648648648648649;exitY=0.0;entryX=0.5;entryY=1.0;"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="embed" value="EMBEDDING = token sau backbone, trước head. Prototype scores phục vụ loss, không phải class label.&#10;B = số ảnh trong batch; D = embedding dimension. Registers không thuộc paper gốc này." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=22;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="40" y="1010" width="1720" height="110" as="geometry" /></mxCell><mxCell id="footer" value="Paper §4–§5 | Code: ssl_meta_arch.py, augmentations.py, configs/train/vitg14.yaml. Xanh lá: teacher; xanh dương: student." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=16;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="40" y="1175" width="1720" height="50" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="03 Losses" id="03"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1800" pageHeight="1250"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="DINOv2 | Loss và cách ghép mục tiêu" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=31;fontFamily=Arial;fontStyle=1;spacing=14;"><mxGeometry x="40" y="25" width="1720" height="60" as="geometry" /></mxCell><mxCell id="sub" value="g1, g2: hai global crops. V = {g1, g2, l1, …, l8}. M_g: vị trí mask trên global crop g. H(q,p) = −Σ q log p." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=20;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="40" y="95" width="1720" height="60" as="geometry" /></mxCell><mxCell id="dino" value="1. IMAGE LEVEL — DINO&#10;L_DINO = mean H(q_t(g), p_s(v))&#10;g ∈ {g1,g2}; v ∈ V; v ≠ g&#10;&#10;Teacher g1 → student g2 + local&#10;Teacher g2 → student g1 + local&#10;Không ghép global cùng view." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e4efff;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=22;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="40" y="210" width="540" height="290" as="geometry" /></mxCell><mxCell id="ibot" value="2. PATCH LEVEL — iBOT&#10;L_iBOT = mean H(q_t(g,i), p_s(g,i))&#10;g ∈ {g1,g2}; i ∈ M_g&#10;&#10;Cùng crop, cùng vị trí patch&#10;Teacher nhìn patch; student bị che&#10;Dự đoán phân phối, không tái tạo RGB." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#def5ea;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=22;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="630" y="210" width="540" height="290" as="geometry" /></mxCell><mxCell id="koleo" value="3. EMBEDDING — KoLeo&#10;u_i = z_i / ||z_i||₂&#10;d_i = min_{j ≠ i} ||u_i − u_j||₂&#10;L_KoLeo = −(1/n) Σ log d_i&#10;&#10;Áp dụng trên student CLS tokens&#10;Khuyến khích đặc trưng trải rộng." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eee6ff;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=22;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="1220" y="210" width="540" height="290" as="geometry" /></mxCell><mxCell id="total" value="L_total = L_DINO + L_iBOT + 0,1 × L_KoLeo&#10;Dạng tổng hợp; mean/weight theo crop và masked token được chuẩn hóa trong&#10;code." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff0d6;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=25;fontFamily=Arial;fontStyle=1;spacing=14;"><mxGeometry x="400" y="610" width="1000" height="130" as="geometry" /></mxCell><mxCell id="edge1" source="dino" target="total" edge="1" parent="1" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#466480;dashed=0;exitX=0.5;exitY=1.0;entryX=0.25;entryY=0.0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="310" y="560" /><mxPoint x="650" y="560" /></Array></mxGeometry></mxCell><mxCell id="edge2" source="ibot" target="total" edge="1" parent="1" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#466480;dashed=0;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge3" source="koleo" target="total" edge="1" parent="1" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#466480;dashed=0;exitX=0.5;exitY=1.0;entryX=0.75;entryY=0.0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1490" y="560" /><mxPoint x="1150" y="560" /></Array></mxGeometry></mxCell><mxCell id="target" value="TẠO TARGET&#10;Student: softmax với temperature T_s&#10;Teacher: temperature T_t + Sinkhorn–Knopp&#10;Target teacher được detach&#10;Head DINO và head iBOT không chia sẻ trọng số." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=22;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="40" y="840" width="820" height="240" as="geometry" /></mxCell><mxCell id="meaning" value="GIỚI HẠN CỦA LOSS&#10;Khớp teacher ≠ có ground-truth embedding&#10;Loss thấp ≠ phân loại downstream tốt&#10;Đặc trưng được đánh giá riêng bằng probe/k-NN&#10;KoLeo: paper và code có khác biệt phạm vi crop (README)." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=22;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="940" y="840" width="820" height="240" as="geometry" /></mxCell><mxCell id="footer" value="Paper §4, Appendix B.1 | Code ssl_meta_arch.py: cross-view global pairing, same-position masking, per-crop loss normalization." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=16;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="40" y="1175" width="1720" height="50" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="04 Training" id="04"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1800" pageHeight="1250"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="DINOv2 | Một training step và lịch huấn luyện" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=31;fontFamily=Arial;fontStyle=1;spacing=14;"><mxGeometry x="40" y="25" width="1720" height="60" as="geometry" /></mxCell><mxCell id="sub" value="Đây là pretraining model lớn từ đầu. Các con số bên phải lấy từ paper Table 16 / Appendix B, không lấy YAML mặc định." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=20;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="40" y="95" width="1720" height="60" as="geometry" /></mxCell><mxCell id="a" value="1. Lấy batch ảnh LVD-142M&#10;Không dùng class label / caption." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e4efff;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=21;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="60" y="190" width="850" height="110" as="geometry" /></mxCell><mxCell id="b" value="2. Tạo 2 global + 8 local crops&#10;Random resized crop, flip; color jitter, grayscale, blur / solarize." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#def5ea;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=21;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="60" y="335" width="850" height="110" as="geometry" /></mxCell><mxCell id="edge1" source="a" target="b" edge="1" parent="1" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#466480;dashed=0;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="c" value="3. Mask một phần global student&#10;Teacher nhận global không mask; local student không mask." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e4efff;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=21;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="60" y="480" width="850" height="110" as="geometry" /></mxCell><mxCell id="edge2" source="b" target="c" edge="1" parent="1" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#466480;dashed=0;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="d" value="4. Teacher forward: no_grad&#10;Student forward: có autograd; tính DINO + iBOT + KoLeo." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#def5ea;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=21;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="60" y="625" width="850" height="110" as="geometry" /></mxCell><mxCell id="edge3" source="c" target="d" edge="1" parent="1" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#466480;dashed=0;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="e" value="5. Backward → AdamW student&#10;Cập nhật backbone và hai head student." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e4efff;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=21;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="60" y="770" width="850" height="110" as="geometry" /></mxCell><mxCell id="edge4" source="d" target="e" edge="1" parent="1" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#466480;dashed=0;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="f" value="6. EMA teacher sau optimizer step&#10;Cập nhật schedule; tiếp tục batch kế tiếp." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#def5ea;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=21;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="60" y="915" width="850" height="110" as="geometry" /></mxCell><mxCell id="edge5" source="e" target="f" edge="1" parent="1" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#466480;dashed=0;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="config" value="PRETRAIN ViT-g/14 — PAPER&#10;AdamW; batch size 3072&#10;625k iterations; LR 3,5 × 10⁻⁴&#10;Warmup 100k iterations&#10;Weight decay cosine: 0,04 → 0,2&#10;EMA momentum cosine: 0,994 → 1&#10;Stochastic depth: 0,4; LayerScale: 10⁻⁵&#10;FP16; head gradient reduction FP32" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff0d6;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=23;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="1010" y="190" width="730" height="385" as="geometry" /></mxCell><mxCell id="high" value="HIGH-RES ADAPTATION&#10;518 × 518; 10k iterations bổ sung&#10;Nén các schedule; giảm base LR&#10;Không nhầm với 625k iterations ban đầu." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff0d6;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=22;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="1010" y="635" width="730" height="165" as="geometry" /></mxCell><mxCell id="infra" value="HẠ TẦNG / HIỆU SUẤT&#10;Memory-efficient attention; sequence packing&#10;Efficient stochastic depth; FSDP&#10;Packing dùng block-diagonal attention mask." vertex="1" parent="1" style="rounded=1;whiteSpace=