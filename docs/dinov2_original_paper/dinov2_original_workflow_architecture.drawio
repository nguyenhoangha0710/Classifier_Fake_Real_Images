                <mxCell id="edge3" edge="1" parent="1" source="koleo" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#466480;dashed=0;exitX=0.5;exitY=1.0;entryX=0.75;entryY=0.0;" target="total">
