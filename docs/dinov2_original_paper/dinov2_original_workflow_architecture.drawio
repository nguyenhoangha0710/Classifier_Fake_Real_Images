    <diagram name="03 Losses" id="03">
        <mxGraphModel dx="2160" dy="1253" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1250" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=31;fontFamily=Arial;fontStyle=1;spacing=14;" value="DINOv2 | Loss và cách ghép mục tiêu" vertex="1">
                    <mxGeometry height="60" width="1720" x="40" y="25" as="geometry"/>
                </mxCell>
                <mxCell id="sub" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=20;fontFamily=Arial;fontStyle=0;spacing=14;" value="g1, g2: hai global crops. V = {g1, g2, l1, …, l8}. M_g: vị trí mask trên global crop g. H(q,p) = −Σ q log p." vertex="1">
                    <mxGeometry height="60" width="1720" x="40" y="95" as="geometry"/>
                </mxCell>
                <mxCell id="dino" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e4efff;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=22;fontFamily=Arial;fontStyle=0;spacing=14;" value="1. IMAGE LEVEL — DINO&#xa;L_DINO = mean H(q_t(g), p_s(v))&#xa;g ∈ {g1,g2}; v ∈ V; v ≠ g&#xa;&#xa;Teacher g1 → student g2 + local&#xa;Teacher g2 → student g1 + local&#xa;Không ghép global cùng view." vertex="1">
                    <mxGeometry height="290" width="540" x="40" y="210" as="geometry"/>
                </mxCell>
                <mxCell id="ibot" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#def5ea;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=22;fontFamily=Arial;fontStyle=0;spacing=14;" value="2. PATCH LEVEL — iBOT&#xa;L_iBOT = mean H(q_t(g,i), p_s(g,i))&#xa;g ∈ {g1,g2}; i ∈ M_g&#xa;&#xa;Cùng crop, cùng vị trí patch&#xa;Teacher nhìn patch; student bị che&#xa;Dự đoán phân phối, không tái tạo RGB." vertex="1">
                    <mxGeometry height="290" width="540" x="630" y="210" as="geometry"/>
                </mxCell>
                <mxCell id="koleo" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eee6ff;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=22;fontFamily=Arial;fontStyle=0;spacing=14;" value="3. EMBEDDING — KoLeo&#xa;u_i = z_i / ||z_i||₂&#xa;d_i = min_{j ≠ i} ||u_i − u_j||₂&#xa;L_KoLeo = −(1/n) Σ log d_i&#xa;&#xa;Áp dụng trên student CLS tokens&#xa;Khuyến khích đặc trưng trải rộng." vertex="1">
                    <mxGeometry height="290" width="540" x="1220" y="210" as="geometry"/>
                </mxCell>
                <mxCell id="total" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff0d6;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=25;fontFamily=Arial;fontStyle=1;spacing=14;" value="L_total = L_DINO + L_iBOT + 0,1 × L_KoLeo&#xa;Dạng tổng hợp; mean/weight theo crop và masked token được chuẩn hóa trong&#xa;code." vertex="1">
                    <mxGeometry height="130" width="1000" x="400" y="610" as="geometry"/>
                </mxCell>
                <mxCell id="edge1" edge="1" parent="1" source="dino" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#466480;dashed=0;exitX=0.5;exitY=1.0;entryX=0.25;entryY=0.0;" target="total">
                    <mxGeometry relative="1" as="geometry">
