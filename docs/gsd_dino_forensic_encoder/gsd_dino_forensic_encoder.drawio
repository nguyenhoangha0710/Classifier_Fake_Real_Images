rial;fontStyle=0;spacing=14;"><mxGeometry x="40" y="455" width="440" height="140" as="geometry" /></mxCell><mxCell id="edge3" source="mask" target="front" edge="1" parent="1" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#466480;dashed=0;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1505" y="400" /><mxPoint x="260" y="400" /></Array></mxGeometry></mxCell><mxCell id="b21" value="CLIP block 21 → GSD21&#10;Dùng V21 [1024,64]&#10;Giữ nguyên [B,N+1,1024]" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eee6ff;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=23;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="610" y="455" width="510" height="140" as="geometry" /></mxCell><mxCell id="b22" value="CLIP block 22 → GSD22&#10;Dùng V22 [1024,64]&#10;Giữ nguyên [B,N+1,1024]" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eee6ff;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=23;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="1250" y="455" width="510" height="140" as="geometry" /></mxCell><mxCell id="edge4" source="front" target="b21" edge="1" parent="1" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#466480;dashed=0;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge5" source="b21" target="b22" edge="1" parent="1" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#466480;dashed=0;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="b23" value="CLIP block 23 → GSD23&#10;Dùng V23 [1024,64]&#10;CLS và patch positions vẫn giữ nguyên" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eee6ff;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=23;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="1250" y="730" width="510" height="140" as="geometry" /></mxCell><mxCell id="b24" value="CLIP block 24 → GSD24&#10;Dùng V24 [1024,64]&#10;GSD áp dụng lên toàn chuỗi token" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eee6ff;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=23;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="610" y="730" width="510" height="140" as="geometry" /></mxCell><mxCell id="out" value="Final CLIP LayerNorm&#10;CLS: [B,1024]&#10;Patches: [B,N,1024]&#10;KHÔNG patch-mean trước iBOT" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#def5ea;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=22;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="40" y="730" width="440" height="140" as="geometry" /></mxCell><mxCell id="edge6" source="b22" target="b23" edge="1" parent="1" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#466480;dashed=0;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge7" source="b23" target="b24" edge="1" parent="1" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#466480;dashed=0;exitX=0.0;exitY=0.5;entryX=1.0;entryY=0.5;"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge8" source="b24" target="out" edge="1" parent="1" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#466480;dashed=0;exitX=0.0;exitY=0.5;entryX=1.0;entryY=0.5;"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="formula" value="GSD_l: F_parallel = (F_l V_l) V_l^T ; r = ||F_parallel||²_F / (||F_l||²_F + ε)&#10;λ_l = λ_max sigmoid(a_l r + b_l) ; F_hat = F_l − λ_l F_parallel&#10;V_l cố định; a_l,b_l học ở student / EMA ở teacher. Không dùng CLIP visual projection hoặc text encoder." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=22;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="40" y="990" width="1720" height="130" as="geometry" /></mxCell><mxCell id="footer" value="GSD xử lý chiều feature, không xóa/đổi thứ tự token. Embedding cuối dùng hidden dimension 1024 của CLIP ViT-L/14." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=16;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="40" y="1175" width="1720" height="50" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="05 Crops and mask" id="05"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1800" pageHeight="1250"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Model đề xuất | Crop ở ngoài encoder; mask ở bên trong student" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=31;fontFamily=Arial;fontStyle=1;spacing=14;"><mxGeometry x="40" y="25" width="1720" height="60" as="geometry" /></mxCell><mxCell id="sub" value="Crop = chọn một vùng ảnh raw. Patch embedding = chuyển crop thành token. Mask = thay nội dung token, không xóa vị trí." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=20;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="40" y="95" width="1720" height="60" as="geometry" /></mxCell><mxCell id="raw" value="Ảnh raw REAL&#10;Đọc/decode từ dataset&#10;Không có nhánh raw riêng&#10;ngoài teacher/student" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=22;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="40" y="210" width="360" height="140" as="geometry" /></mxCell><mxCell id="prep" value="PREPROCESSING / AUGMENTATION&#10;DINOv2-style multi-crop&#10;2 global 224×224 + 8 local 98×98&#10;Augment → tensor → normalize" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e4efff;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=22;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="490" y="210" width="580" height="140" as="geometry" /></mxCell><mxCell id="views" value="Teacher nhận global views&#10;Student nhận global + local views&#10;Mỗi encoder tự thực hiện patch embedding&#10;Cùng global view có cùng lưới vị trí" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#def5ea;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=22;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="1160" y="210" width="600" height="140" as="geometry" /></mxCell><mxCell id="edge1" source="raw" target="prep" edge="1" parent="1" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#466480;dashed=0;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge2" source="prep" target="views" edge="1" parent="1" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#466480;dashed=0;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="tseq" value="TEACHER — GLOBAL VIEW g1&#10;[CLS] [p1] [p2] [p3] [p4] …&#10;Không mask; đi qua CLIP + GSD&#10;Đầu ra có token tại mọi vị trí" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#def5ea;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=23;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="40" y="480" width="800" height="150" as="geometry" /></mxCell><mxCell id="sseq" value="STUDENT — CÙNG GLOBAL VIEW g1&#10;[CLS] [p1] [MASK] [p3] [MASK] …&#10;Mask token học được, thêm vị trí trước Transformer&#10;Đầu ra vẫn có token số 2, số 4, …" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e4efff;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=23;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="960" y="480" width="800" height="150" as="geometry" /></mxCell><mxCell id="dino" value="DINO — KHÁC VIEW&#10;Teacher CLS(g1) → student CLS(g2), CLS(local)&#10;Teacher CLS(g2) → student CLS(g1), CLS(local)&#10;Không ghép teacher/student global cùng view" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff0d6;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=22;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="40" y="770" width="800" height="165" as="geometry" /></mxCell><mxCell id="ibot" value="iBOT — CÙNG VIEW, CÙNG VỊ TRÍ&#10;Teacher patch(g1,2) → student patch(g1,2) bị che&#10;Teacher patch(g1,4) → student patch(g1,4) bị che&#10;Loss chỉ chọn masked indices, không ghép chéo crop" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff0d6;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=22;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="960" y="770" width="800" height="165" as="geometry" /></mxCell><mxCell id="edge3" source="tseq" target="ibot" edge="1" parent="1" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#466480;dashed=0;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="440" y="685" /><mxPoint x="1360" y="685" /></Array></mxGeometry></mxCell><mxCell id="edge4" source="sseq" target="ibot" edge="1" parent="1" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#466480;dashed=0;exitX=0.7125;exitY=1.0;entryX=0.7125;entryY=0.0;"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="note" value="Global student: một phần patch được mask; local student: không mask; CLS không mask.&#10;Không bôi đen ảnh RGB để thay thế token masking. Fixed reference basis không xem crop hiện tại." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=22;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="40" y="1010" width="1720" height="110" as="geometry" /></mxCell><mxCell id="footer" value="2 global / 8 local, 224/98 theo cấu hình ViT-g DINOv2 phát hành. Augmentation giữ recipe gốc; khả năng phù hợp forensic cần được đánh giá." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=16;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="40" y="1175" width="1720" height="50" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="06 Losses" id="06"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1800" pageHeight="1250"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Model đề xuất | Ba loss và đúng vị trí lấy đặc trưng" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=31;fontFamily=Arial;fontStyle=1;spacing=14;"><mxGeometry x="40" y="25" width="1720" height="60" as="geometry" /></mxCell><mxCell id="sub" value="K_D / K_P: số prototype của hai head, CHƯA CHỐT. Khác hoàn toàn k=64 của GSD. H(q,p) = −Σ_j q_j log p_j." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=20;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="40" y="95" width="1720" height="60" as="geometry" /></mxCell><mxCell id="dino" value="1. DINO — CLS → DINO HEAD&#10;p_s = softmax(head_s(CLS_s) / τ_s)&#10;q_t = teacher targets sau Sinkhorn–Knopp&#10;L_D = mean H(q_t(g), p_s(v))&#10;&#10;Chỉ cặp view khác nhau, cùng ảnh&#10;2 global × (1 global khác + 8 local)&#10;= 18 cặp mỗi ảnh; teacher target detach" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e4efff;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=21;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="40" y="210" width="540" height="340" as="geometry" /></mxCell><mxCell id="ibot" value="2. iBOT — PATCH → iBOT HEAD&#10;p_s^P = softmax(head_s(P_s) / τ_s)&#10;q_t^P = target patch teacher, đã detach&#10;L_P = mean_crop mean_mask H(q_t^P, p_s^P)&#10;&#10;Cùng global crop, cùng patch index&#10;Normalize theo số mask của từng crop&#10;Không-mask crop đóng góp 0" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#def5ea;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=21;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="630" y="210" width="540" height="340" as="geometry" /></mxCell><mxCell id="koleo" value="3. KoLeo — CLS TRƯỚC HEAD&#10;u_b = CLS_b / ||CLS_b||2&#10;d_b = min_{c ≠ b} ||u_b − u_c||2&#10;L_K^(g) = −mean_b log(d_b + ε)&#10;&#10;Chỉ student global CLS&#10;Tính riêng g1 và g2 rồi cộng&#10;Không lấy hai views cùng ảnh làm NN" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eee6ff;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=21;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="1220" y="210" width="540" height="340" as="geometry" /></mxCell><mxCell id="total" value="L_total = L_DINO + L_iBOT + 0,1 × L_KoLeo&#10;Giữ loss normalization và teacher-target balancing của DINOv2 code." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff0d6;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=25;fontFamily=Arial;fontStyle=1;spacing=14;"><mxGeometry x="390" y="660" width="1020" height="130" as="geometry" /></mxCell><mxCell id="edge1" source="dino" target="total" edge="1" parent="1" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#466480;dashed=0;exitX=0.5;exitY=1.0;entryX=0.2549019607843137;entryY=0.0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="310" y="610" /><mxPoint x="650" y="610" /></Array></mxGeometry></mxCell><mxCell id="edge2" source="ibot" target="total" edge="1" parent="1" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#466480;dashed=0;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge3" source="koleo" target="total" edge="1" parent="1" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#466480;dashed=0;exitX=0.5;exitY=1.0;entryX=0.7450980392156863;entryY=0.0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1490" y="610" /><mxPoint x="1150" y="610" /></Array></mxGeometry></mxCell><mxCell id="grad" value="GRADIENT ĐI QUA&#10;Student heads → token embeddings → GSD → CLIP&#10;KoLeo đi trực tiếp từ CLS trước head&#10;Mask token nhận gradient qua student&#10;Basis V và semantic anchor không nhận gradient" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e4efff;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=22;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="40" y="890" width="820" height="210" as="geometry" /></mxCell><mxCell id="limits" value="Ý NGHĨA / GIỚI HẠN&#10;DINO: nhất quán toàn ảnh giữa views&#10;iBOT: dự đoán phân phối đặc trưng vùng bị che&#10;KoLeo: khuyến khích độ phân tán embedding&#10;Không có BCE/CE real–fake; chưa bảo đảm forensic" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=22;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="940" y="890" width="820" height="210" as="geometry" /></mxCell><mxCell id="footer" value="DINOv2 losses: dino_clstoken_loss.py, ibot_patch_loss.py, koleo_loss.py và ssl_meta_arch.py. Không thay bằng Barlow Twins/VICReg." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=16;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="40" y="1175" width="1720" height="50" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="07 Training and export" id="07"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1800" pageHeight="1250"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Model đề xuất | Vòng train, EMA và export encoder" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=31;fontFamily=Arial;fontStyle=1;spacing=14;"><mxGeometry x="40" y="25" width="1720" height="60" as="geometry" /></mxCell><mxCell id="sub" value="Giữ cơ chế DINOv2; không áp nguyên lịch 625k iterations / batch / LR của ViT-g train từ đầu lên CLIP pretrained." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=20;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="40" y="95" width="1720" height="60" as="geometry" /></mxCell><mxCell id="a" value="1. Nạp batch REAL → tạo global/local crops&#10;Dùng manifest hợp lệ từ pool 200K; không lấy fake." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e4efff;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=21;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="40" y="190" width="900" height="110" as="geometry" /></mxCell><mxCell id="b" value="2. Student global: thay patch bằng mask token&#10;Teacher global và student local không mask." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#def5ea;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=21;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="40" y="335" width="900" height="110" as="geometry" /></mxCell><mxCell id="edge1" source="a" target="b" edge="1" parent="1" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#466480;dashed=0;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="c" value="3. Teacher forward no_grad + student forward&#10;Cả hai dùng cùng các fixed reference basis." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e4efff;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=21;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="40" y="480" width="900" height="110" as="geometry" /></mxCell><mxCell id="edge2" source="b" target="c" edge="1" parent="1" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#466480;dashed=0;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="d" value="4. Tính DINO + iBOT + 0,1 KoLeo&#10;Zero-grad → backward → AdamW cập nhật student." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#def5ea;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=21;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="40" y="625" width="900" height="110" as="geometry" /></mxCell><mxCell id="edge3" source="c" target="d" edge="1" parent="1" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#466480;dashed=0;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="e" value="5. EMA sau optimizer step&#10;θ_t ← m θ_t + (1−m) θ_s; không EMA basis." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e4efff;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=21;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="40" y="770" width="900" height="110" as="geometry" /></mxCell><mxCell id="edge4" source="d" target="e" edge="1" parent="1" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#466480;dashed=0;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="f" value="6. Log, checkpoint và validation protocol riêng&#10;Chỉ export trọng số train hợp lệ; không dùng test để chọn model." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#def5ea;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=21;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="40" y="915" width="900" height="110" as="geometry" /></mxCell><mxCell id="edge5" source="e" target="f" edge="1" parent="1" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#466480;dashed=0;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="state" value="QUY TẮC TRẠNG THÁI&#10;Student = trainable CLIP + GSD + hai heads&#10;Teacher = copy student lúc đầu, rồi EMA&#10;Frozen CLIP anchor chỉ dùng tạo basis offline&#10;Basis lưu dạng buffer/artifact cố định&#10;EMA không đồng nghĩa λ_student = λ_teacher" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eee6ff;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=22;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="1040" y="190" width="720" height="260" as="geometry" /></mxCell><mxCell id="export" value="EXPORT / INFERENCE&#10;Giữ teacher EMA encoder + 4 basis&#10;Bỏ DINO/iBOT heads; không masking&#10;Ảnh → preprocessing → CLIP+GSD → LayerNorm&#10;CLS [B,1024] hoặc patches [B,N,1024]&#10;Classifier / density model là bước downstream riêng" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#def5ea;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=22;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="1040" y="510" width="720" height="230" as="geometry" /></mxCell><mxCell id="todo" value="THÔNG SỐ CHƯA CHỐT&#10;Reference size và sampling / preprocessing policy&#10;Số prototypes và cấu hình head&#10;LR từng nhóm, batch, số bước / epochs&#10;Warmup, momentum / temperature schedules&#10;Ngưỡng lọc ảnh nhỏ; policy validation&#10;Chưa tự thêm high-res stage hoặc model distillation" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff0d6;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=21;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="1040" y="800" width="720" height="260" as="geometry" /></mxCell><mxCell id="footer" value="Artifact này mô tả thiết kế; không thay code training đang có và không khởi chạy train. Protocol đánh giá forensic cần khóa trước khi chạy." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=16;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="40" y="1175" width="1720" height="50" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>