<mxfile host="app.diagrams.net" version="24.7.17"><diagram name="01 Workflow" id="01"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1800" pageHeight="1250"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Model đề xuất | Workflow tổng thể" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=31;fontFamily=Arial;fontStyle=1;spacing=14;"><mxGeometry x="40" y="25" width="1720" height="60" as="geometry" /></mxCell><mxCell id="sub" value="Real-only 200K • CLIP ViT-L/14 pretrained • GSD last 4, k=64 • Fixed reference basis • DINOv2-style SSL" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=20;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="40" y="95" width="1720" height="60" as="geometry" /></mxCell><mxCell id="raw" value="POOL 200K ẢNH REAL&#10;Ảnh raw từ dataset&#10;Không thêm fake vào&#10;pretraining" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e4efff;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=23;fontFamily=Arial;fontStyle=1;spacing=14;"><mxGeometry x="40" y="210" width="360" height="150" as="geometry" /></mxCell><mxCell id="manifest" value="Audit / lọc ảnh nhỏ, lỗi và trùng&#10;Khóa manifest train và nguồn dữ liệu&#10;Ghi số ảnh hợp lệ thực tế sau lọc" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e4efff;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=22;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="490" y="210" width="520" height="150" as="geometry" /></mxCell><mxCell id="ref" value="Chọn reference từ TRAIN&#10;Không dùng validation/test&#10;Số ảnh và policy reference: CHƯA CHỐT" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eee6ff;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=22;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="1130" y="210" width="630" height="150" as="geometry" /></mxCell><mxCell id="edge1" source="raw" target="manifest" edge="1" parent="1" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#466480;dashed=0;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge2" source="manifest" target="ref" edge="1" parent="1" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#466480;dashed=0;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="basis" value="OFFLINE: frozen CLIP → SVD&#10;4 basis V21,V22,V23,V24&#10;Mỗi basis [1024,64], giữ cố định" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eee6ff;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=23;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="1130" y="460" width="630" height="155" as="geometry" /></mxCell><mxCell id="edge3" source="ref" target="basis" edge="1" parent="1" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#466480;dashed=0;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="init" value="Khởi tạo student = CLIP pretrained + GSD + DINO/iBOT heads&#10;Teacher = copy toàn bộ student ban đầu&#10;Trainable student; teacher cập nhật EMA" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#def5ea;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=23;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="40" y="460" width="970" height="155" as="geometry" /></mxCell><mxCell id="ssl" value="ONLINE SSL&#10;Ảnh raw → preprocessing tạo global/local crops → teacher/student&#10;DINO + iBOT + 0,1 KoLeo → gradient student → EMA teacher&#10;Không chạy semantic anchor/SVD lại trong từng training step" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff0d6;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=23;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="490" y="740" width="1270" height="175" as="geometry" /></mxCell><mxCell id="edge4" source="manifest" target="ssl" edge="1" parent="1" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#466480;dashed=0;exitX=0.5;exitY=1.0;entryX=0.2440944881889764;entryY=0.0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1055" y="360" /><mxPoint x="1055" y="690" /><mxPoint x="800" y="690" /></Array></mxGeometry></mxCell><mxCell id="edge5" source="init" target="ssl" edge="1" parent="1" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#466480;dashed=0;exitX=0.5;exitY=1.0;entryX=0.027559055118110236;entryY=0.0;"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge6" source="basis" target="ssl" edge="1" parent="1" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#8b5cc6;dashed=1;exitX=0.5;exitY=1.0;entryX=0.7519685039370079;entryY=0.0;"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="export" value="Export encoder teacher EMA + basis + preprocessing contract&#10;Bỏ DINO/iBOT heads → CLS / patch embeddings → đánh giá downstream riêng" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#def5ea;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=23;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="490" y="1005" width="1270" height="110" as="geometry" /></mxCell><mxCell id="edge7" source="ssl" target="export" edge="1" parent="1" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#466480;dashed=0;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="footer" value="Thiết kế đã thống nhất trong chat. Đây là biến thể nghiên cứu CLIP+GSD kết hợp DINOv2; chưa có kết quả training xác nhận." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=16;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="40" y="1175" width="1720" height="50" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="02 Reference basis" id="02"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1800" pageHeight="1250"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Model đề xuất | Tạo basis GSD một lần, trước khi train" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=31;fontFamily=Arial;fontStyle=1;spacing=14;"><mxGeometry x="40" y="25" width="1720" height="60" as="geometry" /></mxCell><mxCell id="sub" value="Cách B đã chọn: basis độc lập với ảnh/crop đang xử lý. Basis cố định; không đồng nghĩa mức suppression λ cố định." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=20;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="40" y="95" width="1720" height="60" as="geometry" /></mxCell><mxCell id="ref" value="Reference ảnh REAL&#10;Lấy trong manifest train&#10;Policy crop/resize và số ảnh&#10;CHƯA CHỐT" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e4efff;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=22;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="40" y="220" width="340" height="160" as="geometry" /></mxCell><mxCell id="anchor" value="CLIP ViT-L/14 pretrained&#10;Semantic anchor FROZEN&#10;Eval mode, no_grad&#10;Không mask trong bước offline" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#def5ea;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=22;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="470" y="220" width="400" height="160" as="geometry" /></mxCell><mxCell id="features" value="Lấy PATCH tokens&#10;Sau các block 21,22,23,24&#10;Không lấy CLS để fit basis&#10;Mỗi token: 1024 chiều" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#def5ea;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=22;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="960" y="220" width="370" height="160" as="geometry" /></mxCell><mxCell id="svd" value="Gộp token theo từng layer&#10;P_l = U_l Σ_l V_l^T&#10;Lấy 64 right singular vectors" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eee6ff;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=22;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="1420" y="220" width="340" height="160" as="geometry" /></mxCell><mxCell id="edge1" source="ref" target="anchor" edge="1" parent="1" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#466480;dashed=0;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge2" source="anchor" target="features" edge="1" parent="1" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#466480;dashed=0;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge3" source="features" target="svd" edge="1" parent="1" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#466480;dashed=0;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="v21" value="V21&#10;[1024,64]" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eee6ff;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=25;fontFamily=Arial;fontStyle=1;spacing=14;"><mxGeometry x="40" y="560" width="360" height="130" as="geometry" /></mxCell><mxCell id="v22" value="V22&#10;[1024,64]" vertex="1" parent="1" style="rounded=1;whi