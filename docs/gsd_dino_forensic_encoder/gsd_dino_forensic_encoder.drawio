    <diagram name="06 Losses" id="06">
        <mxGraphModel dx="2160" dy="1253" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1250" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=31;fontFamily=Arial;fontStyle=1;spacing=14;" value="Model đề xuất | Ba loss và đúng vị trí lấy đặc trưng" vertex="1">
                    <mxGeometry height="60" width="1720" x="40" y="25" as="geometry"/>
                </mxCell>
                <mxCell id="sub" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=20;fontFamily=Arial;fontStyle=0;spacing=14;" value="K_D / K_P: số prototype của hai head, CHƯA CHỐT. Khác hoàn toàn k=64 của GSD. H(q,p) = −Σ_j q_j log p_j." vertex="1">
                    <mxGeometry height="60" width="1720" x="40" y="95" as="geometry"/>
                </mxCell>
                <mxCell id="dino" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e4efff;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=21;fontFamily=Arial;fontStyle=0;spacing=14;" value="1. DINO — CLS → DINO HEAD&#xa;p_s = softmax(head_s(CLS_s) / τ_s)&#xa;q_t = teacher targets sau Sinkhorn–Knopp&#xa;L_D = mean H(q_t(g), p_s(v))&#xa;&#xa;Chỉ cặp view khác nhau, cùng ảnh&#xa;2 global × (1 global khác + 8 local)&#xa;= 18 cặp mỗi ảnh; teacher target detach" vertex="1">
                    <mxGeometry height="340" width="540" x="40" y="210" as="geometry"/>
                </mxCell>
                <mxCell id="ibot" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#def5ea;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=21;fontFamily=Arial;fontStyle=0;spacing=14;" value="2. iBOT — PATCH → iBOT HEAD&#xa;p_s^P = softmax(head_s(P_s) / τ_s)&#xa;q_t^P = target patch teacher, đã detach&#xa;L_P = mean_crop mean_mask H(q_t^P, p_s^P)&#xa;&#xa;Cùng global crop, cùng patch index&#xa;Normalize theo số mask của từng crop&#xa;Không-mask crop đóng góp 0" vertex="1">
                    <mxGeometry height="340" width="540" x="630" y="210" as="geometry"/>
                </mxCell>
                <mxCell id="koleo" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eee6ff;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=21;fontFamily=Arial;fontStyle=0;spacing=14;" value="3. KoLeo — CLS TRƯỚC HEAD&#xa;u_b = CLS_b / ||CLS_b||2&#xa;d_b = min_{c ≠ b} ||u_b − u_c||2&#xa;L_K^(g) = −mean_b log(d_b + ε)&#xa;&#xa;Chỉ student global CLS&#xa;Tính riêng g1 và g2 rồi cộng&#xa;Không lấy hai views cùng ảnh làm NN" vertex="1">
                    <mxGeometry height="340" width="540" x="1220" y="210" as="geometry"/>
                </mxCell>
