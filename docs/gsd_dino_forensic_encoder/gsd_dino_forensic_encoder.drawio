#8b5cc6;dashed=0;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1590" y="470" /><mxPoint x="1575" y="470" /></Array></mxGeometry></mxCell><mxCell id="save" value="LƯU BASIS ARTIFACT&#10;4 ma trận FP32; V_l^T V_l ≈ I64&#10;Khóa CLIP checkpoint, reference IDs/hash&#10;Lưu layer, k, preprocessing và phương pháp fit&#10;SVD không center để khớp phép GSD hiện tại" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eee6ff;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=22;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="40" y="820" width="810" height="210" as="geometry" /></mxCell><mxCell id="reuse" value="DÙNG LẠI TRONG TRAIN VÀ INFERENCE&#10;Student + teacher dùng cùng V_l ở từng layer&#10;Không fit lại theo batch, không EMA basis&#10;Local crop 49 patch vẫn nhân được với V_l [1024,64]&#10;Tập reference không tham gia làm target riêng" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#def5ea;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=22;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="940" y="820" width="820" height="210" as="geometry" /></mxCell><mxCell id="edge8" source="save" target="reuse" edge="1" parent="1" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#466480;dashed=0;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="footer" value="GSD paper: reference-based inference. Dùng fixed reference basis cả lúc SSL là quyết định của model đề xuất, không phải recipe đã được paper kiểm chứng." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=16;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="40" y="1175" width="1720" height="50" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="03 Teacher student" id="03"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1800" pageHeight="1250"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Model đề xuất | Kiến trúc teacher–student" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=31;fontFamily=Arial;fontStyle=1;spacing=14;"><mxGeometry x="40" y="25" width="1720" height="60" as="geometry" /></mxCell><mxCell id="sub" value="Cả hai encoder đều khởi tạo từ CLIP pretrained. Transformer và attention đã nằm bên trong CLIP; GSD là phần chèn thêm." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=20;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="40" y="95" width="1720" height="60" as="geometry" /></mxCell><mxCell id="basis" value="SHARED FIXED BASIS&#10;V21,V22,V23,V24 — [1024,64] mỗi layer" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eee6ff;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=23;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="560" y="190" width="680" height="100" as="geometry" /></mxCell><mxCell id="tin" value="TEACHER INPUT&#10;Hai global crops không mask, từ ảnh REAL" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#def5ea;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=23;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="40" y="355" width="760" height="110" as="geometry" /></mxCell><mxCell id="sin" value="STUDENT INPUT&#10;Cùng global crops + local crops; mask global tokens" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e4efff;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=23;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="1000" y="355" width="760" height="110" as="geometry" /></mxCell><mxCell id="te" value="TEACHER ENCODER — NO GRAD&#10;CLIP ViT-L/14 pretrained: patch embedding + 24 blocks&#10;GSD sau block 21,22,23,24 → final LayerNorm&#10;Teacher backbone và GSD đi theo student bằng EMA" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#def5ea;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=23;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="40" y="560" width="760" height="185" as="geometry" /></mxCell><mxCell id="se" value="STUDENT ENCODER — TRAINABLE&#10;CLIP ViT-L/14 pretrained: patch embedding + 24 blocks&#10;GSD sau block 21,22,23,24 → final LayerNorm&#10;Mask token ở đầu vào; CLS không bị mask" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e4efff;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=23;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="1000" y="560" width="760" height="185" as="geometry" /></mxCell><mxCell id="edge1" source="tin" target="te" edge="1" parent="1" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#466480;dashed=0;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge2" source="sin" target="se" edge="1" parent="1" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#466480;dashed=0;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge3" source="basis" target="te" edge="1" parent="1" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#8b5cc6;dashed=1;exitX=0.47058823529411764;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="880" y="515" /><mxPoint x="420" y="515" /></Array></mxGeometry></mxCell><mxCell id="edge4" source="basis" target="se" edge="1" parent="1" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#8b5cc6;dashed=1;exitX=0.5294117647058824;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="920" y="515" /><mxPoint x="1380" y="515" /></Array></mxGeometry></mxCell><mxCell id="tout" value="CLS: [2B,1024] + patches: [2B,256,1024]&#10;Global crop 224×224; mọi target đều detach" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#def5ea;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=22;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="40" y="820" width="760" height="95" as="geometry" /></mxCell><mxCell id="sout" value="CLS của global + local; patch tokens giữ thứ tự&#10;Global: 256 patches; local 98×98: 49 patches" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e4efff;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=22;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="1000" y="820" width="760" height="95" as="geometry" /></mxCell><mxCell id="edge5" source="te" target="tout" edge="1" parent="1" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#466480;dashed=0;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge6" source="se" target="sout" edge="1" parent="1" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#466480;dashed=0;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="th" value="DINO head_t ← CLS; iBOT head_t ← patch tokens&#10;Temperature + Sinkhorn–Knopp tạo targets&#10;Hai head riêng; được cập nhật bằng EMA" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#def5ea;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=22;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="40" y="990" width="760" height="120" as="geometry" /></mxCell><mxCell id="sh" value="DINO head_s ← CLS; iBOT head_s ← masked patches&#10;Student softmax / log-softmax&#10;KoLeo lấy CLS trực tiếp, trước head" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e4efff;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=22;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="1000" y="990" width="760" height="120" as="geometry" /></mxCell><mxCell id="edge7" source="tout" target="th" edge="1" parent="1" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#466480;dashed=0;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge8" source="sout" target="sh" edge="1" parent="1" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#466480;dashed=0;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="footer" value="Luồng head/loss theo DINOv2. Luồng token GSD theo code hiện tại, đổi sang fixed basis. Chi tiết gradient/EMA ở trang 07." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=16;fontFamily=Arial;fontStyle=0;spacing=14;"><mxGeometry x="40" y="1175" width="1720" height="50" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="04 Inside encoder" id="04"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1800" pageHeight="1250"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Model đề xuất | Bên trong một encoder CLIP + GSD" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=31;fontFamily=Arial;fontStyle=1;spacing=14;"><mxGeometry x="40" y="25" width="1720" height="60" as="geometry" /></mxCell><mxCell id="sub" value="Cùng sơ đồ cho teacher/student. Khác biệt: student có masking ở đầu vào; teacher dùng trọng số EMA và không mask." vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#a4b3c5;fontColor=#17243a;fontSize=20;fontFamily=Arial;fontStyl